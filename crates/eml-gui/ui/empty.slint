import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppWords } from "models.slint";
import { ActionButton, Label } from "controls.slint";
export component EmptyBatch inherits Rectangle {
    in property <AppWords> words;
    in property <bool> enabled;
    in property <string> notice;
    in property <bool> can-reveal-report;
    callback reveal-report();
    in property <bool> hovered;
    callback add-files(); callback add-folder();
    background: Theme.surface;
    Rectangle { width: min(560px, parent.width - Theme.space-6 * 2); height: content.preferred-height + 64px;
        x: (parent.width - self.width) / 2; y: max(0px,(parent.height - self.height) / 2);
        border-width: 2px; border-color: root.hovered ? Theme.accent : Theme.border; border-radius: Theme.radius-container;
        background: root.hovered ? Theme.accent-soft : Theme.surface;
        content := VerticalBox { padding: Theme.space-6; spacing: Theme.space-4; alignment: center;
            Label { text: root.words.empty-title; font-size: Theme.title; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
            Label { text: root.words.empty-body; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
            if root.notice != "": HorizontalBox { padding: 0px; spacing: Theme.space-2; alignment: center;
                Label { text: root.notice; color: Theme.warn; horizontal-alignment: center; overflow: elide; accessible-live-region: polite; }
                if root.can-reveal-report: ActionButton { text: root.words.show-report; clicked => { root.reveal-report(); } }
            }
            HorizontalBox { padding: 0px; spacing: Theme.space-2; alignment: center;
                ActionButton { text: root.words.add-files; enabled: root.enabled; clicked => { root.add-files(); } }
                ActionButton { text: root.words.add-folder; enabled: root.enabled; clicked => { root.add-folder(); } }
            }
        }
    }
}
