import { VerticalBox, HorizontalBox, ListView, ScrollView, ProgressIndicator } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BatchState, Tone, EmailRow, EmailDetail, BatchView, AppWords } from "models.slint";
import { ActionButton, PrimaryButton, TextButton, Label, Chip, ToneDot, UiMetrics, AttachmentChip } from "controls.slint";
export component BatchPane inherits Rectangle {
    min-height: 0px; preferred-height: 0px; max-height: 100000px; vertical-stretch: 1;
    out property <length> destination-anchor-x: destination-content.absolute-position.x;
    out property <length> destination-anchor-y: destination-content.absolute-position.y;
    out property <length> output-anchor-x: output-content.absolute-position.x;
    out property <length> output-anchor-width: output-content.width;
    out property <length> output-anchor-y: output-content.absolute-position.y;
    in property <AppWords> words;
    in property <BatchView> view;
    in property <[EmailRow]> rows;
    in property <EmailDetail> detail;
    in property <bool> hovered;
    callback add-files(); callback add-folder(); callback reset(); callback start(); callback stop();
    callback filter(); callback select(string); callback navigate(int,int); callback clear-selected();
    callback reveal-report(); callback show-copy(); callback show-original(); callback copy-details(); callback destination(); callback output();
    private property <length> column-width: min(Theme.column-max-width,root.width - Theme.space-6 * 2);
    private property <length> column-x: (root.width - self.column-width) / 2;
    private property <length> text-x: root.column-x + UiMetrics.scroll-inset + Theme.space-2;
    private property <length> text-width: root.column-width - 2 * (UiMetrics.scroll-inset + Theme.space-2);
    private property <length> row-height: Theme.row-height;
    private property <bool> wide: root.width >= 900px;
    private property <length> email-column: root.column-width * 0.32;
    private property <length> status-column: 175px;
    private property <length> size-column: 145px;
    private property <length> column-spacing: Theme.space-3;
    private property <length> attachments-column: max(0px, root.text-width - root.column-spacing * (root.wide ? 3 : 2) - root.email-column - root.status-column - (root.wide ? root.size-column : 0px));
    private property <length> scroll-y;
    private property <int> selected-index: root.view.selected-index;
    function reveal-selected() {
        if root.selected-index < 0 { return; }
        let top = root.selected-index * root.row-height;
        let bottom = top + root.row-height;
        if root.scroll-y + top < 0px { root.scroll-y = -top; }
        if root.scroll-y + bottom > emails.visible-height { root.scroll-y = emails.visible-height - bottom; }
        root.scroll-y = max(min(0px,emails.visible-height - root.rows.length * root.row-height),min(0px,root.scroll-y));
    }
    changed selected-index => { root.reveal-selected(); }
    private property <length> list-height: emails.visible-height;
    changed list-height => { root.reveal-selected(); }
    VerticalBox { width: parent.width; height: parent.height; padding: 0px; spacing: 0px;
        Rectangle { height: header.preferred-height;
            header := VerticalBox { x: root.text-x; width: root.text-width; padding-top: Theme.space-4; padding-bottom: Theme.space-3; padding-left: 0px; padding-right: 0px; spacing: Theme.space-2;
                HorizontalBox { min-height: Theme.control-height; padding: 0px; spacing: Theme.space-2;
                    Label { text: root.view.title; font-size: Theme.title; font-weight: 700; horizontal-stretch: 1; overflow: elide; accessible-live-region: polite; }
                    if root.view.state == BatchState.checking || root.view.state == BatchState.ready: ActionButton { text: root.words.add-files; enabled: root.view.can-add; clicked => { root.add-files(); } }
                    if root.view.state == BatchState.checking || root.view.state == BatchState.ready: ActionButton { text: root.words.add-folder; enabled: root.view.can-add; clicked => { root.add-folder(); } }
                    if root.view.state == BatchState.checking || root.view.state == BatchState.ready: ActionButton { text: root.words.start-over; enabled: root.view.can-reset; clicked => { root.reset(); } }
                }
                HorizontalBox { height: Theme.control-height; padding: 0px; spacing: Theme.space-2;
                    Label { text: root.view.summary; color: Theme.muted; overflow: elide; horizontal-stretch: 1; }
                    if root.view.problems != "": Chip { text: root.view.filtered ? root.words.show-all : root.view.problems; selected: root.view.filtered; clicked => { root.filter(); } }
                }
                if root.view.banner != "": Label { text: "⚠ " + root.view.banner; color: Theme.warn; wrap: word-wrap; }
                if root.view.notice != "": HorizontalBox { padding: 0px; spacing: Theme.space-2;
                    Label { text: root.view.notice; color: Theme.warn; overflow: elide; horizontal-stretch: 1; accessible-live-region: polite; }
                    if root.view.can-reveal-report: TextButton { text: root.words.show-report; clicked => { root.reveal-report(); } }
                }
            }
        }
        Rectangle { height: 28px;
            HorizontalBox { x: root.column-x + UiMetrics.scroll-inset; width: root.column-width - UiMetrics.scroll-inset * 2; padding-left: Theme.space-2; padding-right: Theme.space-2; padding-top: 0px; padding-bottom: 0px; spacing: root.column-spacing;
                Label { text: root.words.email; width: root.email-column; color: Theme.muted; }
                Label { text: root.words.attachments; width: root.attachments-column; color: Theme.muted; }
                if root.wide: Label { text: root.words.size; width: root.size-column; color: Theme.muted; }
                Label { text: root.words.status; width: root.status-column; color: Theme.muted; }
            }
        }
        Rectangle { vertical-stretch: 1; min-height: root.row-height * 2 + UiMetrics.scroll-inset * 2;
        list-focus := FocusScope { x: root.column-x; width: root.column-width; height: parent.height;
            key-pressed(event) => {
                if event.text == Key.Escape { root.clear-selected(); return accept; }
                if event.text == Key.DownArrow { root.navigate(1,0); return accept; }
                if event.text == Key.UpArrow { root.navigate(-1,0); return accept; }
                if event.text == Key.Home { root.navigate(0,-1); return accept; }
                if event.text == Key.End { root.navigate(0,1); return accept; }
                if event.text == Key.PageDown { root.navigate(max(1,floor(emails.visible-height / root.row-height)),0); return accept; }
                if event.text == Key.PageUp { root.navigate(-max(1,floor(emails.visible-height / root.row-height)),0); return accept; }
                return reject;
            }
            emails := ListView { width: parent.width; height: parent.height; content-width: self.visible-width; content-y <=> root.scroll-y;
                accessible-role: list; accessible-label: root.words.emails;
                for row[index] in root.rows: Rectangle {
                    height: root.row-height; background: row.selected ? Theme.accent-soft : Theme.surface;
                    border-radius: Theme.radius-control;
                    if index < root.rows.length - 1: Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; opacity: 0.4; }
                    accessible-role: list-item; accessible-label: row.name + ", " + row.status;
                    accessible-description: row.description;
                    accessible-item-selectable: true; accessible-item-selected: row.selected;
                    accessible-action-default => { list-focus.focus(); root.select(row.key); }
                    TouchArea { clicked => { list-focus.focus(); root.select(row.key); } }
                    HorizontalBox { width: parent.width; height: parent.height; padding-left: Theme.space-2; padding-right: Theme.space-2; padding-top: 0px; padding-bottom: 0px; spacing: root.column-spacing;
                        VerticalBox { width: root.email-column; padding: 0px; spacing: 0px; alignment: center;
                            // The suffix keeps the extension visible when the name is clipped.
                            Rectangle { min-height: Theme.line-height; vertical-stretch: 0;
                                prefix := Label { x: 0px; width: min(self.preferred-width,max(0px,parent.width - suffix.preferred-width)); height: parent.height; text: row.prefix; overflow: elide; font-weight: 550; }
                                suffix := Label { x: prefix.width - (prefix.preferred-width > prefix.width ? Theme.space-1 : 0px); width: min(self.preferred-width,max(0px,parent.width - prefix.width)); height: parent.height; text: row.suffix; font-weight: 550; overflow: elide; }
                            }
                            Rectangle { min-height: 17px; vertical-stretch: 0; accessible-role: text; accessible-label: row.folder;
                                folder-prefix := Label { x: 0px; width: min(self.preferred-width,max(0px,parent.width - folder-suffix.preferred-width)); height: parent.height; text: row.folder-prefix; font-size: Theme.small; color: Theme.muted; overflow: elide; accessible-role: none; }
                                folder-suffix := Label { x: folder-prefix.width; width: min(self.preferred-width,max(0px,parent.width - folder-prefix.width)); height: parent.height; text: row.folder-suffix; font-size: Theme.small; color: Theme.muted; overflow: elide; accessible-role: none; }
                            }
                        }
                        VerticalBox { width: root.attachments-column; padding: 0px; alignment: center;
                        HorizontalBox { width: parent.width; height: 22px; padding: 0px; spacing: Theme.space-1;
                            if row.has-chips: AttachmentChip { text: row.chip1; }
                            if !row.has-chips: Label { text: row.chip1; font-size: Theme.small; color: Theme.muted; overflow: elide; }
                            if row.chip2 != "": AttachmentChip { text: row.chip2; }
                            if row.more != "": Label { text: row.more; font-size: Theme.small; color: Theme.muted; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        }
                        if root.wide: Rectangle { width: root.size-column; accessible-role: text; accessible-label: row.size-text;
                            if row.size-reduction-known: Rectangle {
                                before := Label { x: 0px; width: min(self.preferred-width,max(0px,parent.width - after.preferred-width)); height: parent.height; text: row.source-size + " → "; color: Theme.muted; overflow: elide; accessible-role: none; }
                                after := Label { x: before.width; width: min(self.preferred-width,max(0px,parent.width - before.width)); height: parent.height; text: row.copy-size; color: Theme.text; overflow: elide; accessible-role: none; }
                            }
                            if !row.size-reduction-known: Label { text: row.size-text; width: parent.width; height: parent.height; overflow: elide; accessible-role: none; }
                        }
                        VerticalBox { width: root.status-column; padding: 0px; alignment: center;
                        HorizontalBox { height: Theme.line-height; padding: 0px; spacing: Theme.space-2;
                            VerticalBox { width: 8px; padding: 0px; spacing: 0px; alignment: center; ToneDot { tone: Theme.tone(row.tone); } }
                            Label { text: row.status; color: Theme.tone(row.tone); overflow: elide; horizontal-stretch: 1; }
                        }}
                    }
                }
            }
            Rectangle { width: parent.width; height: parent.height; visible: root.hovered; background: transparent; border-width: 2px; border-color: Theme.accent; }
        }
        }
        if root.detail.visible: detail-pane := Rectangle {
            background: Theme.raised;
            detail-separator := Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
            accessible-role: groupbox; accessible-label: root.words.details-label;
            preferred-height: min(root.height * 0.4, 240px);
            max-height: self.preferred-height; min-height: Theme.control-height + Theme.space-6 + Theme.line-height; vertical-stretch: 0;
            VerticalBox { x: root.text-x - UiMetrics.scroll-inset; width: root.text-width + UiMetrics.scroll-inset * 2; height: parent.height; padding-top: Theme.space-2; padding-bottom: Theme.space-2; padding-left: 0px; padding-right: 0px; spacing: Theme.space-2;
                ScrollView { vertical-stretch: 1; min-height: 0px; content-width: self.visible-width; content-height: detail-content.preferred-height;
                    detail-content := VerticalBox { width: parent.visible-width; x: 0px; padding: 0px; spacing: Theme.space-2;
                        Label { text: root.detail.name; font-weight: 650; overflow: elide; }
                        Label { text: root.detail.sentence; wrap: word-wrap; }
                        for part in root.detail.parts: HorizontalBox { padding: 0px; spacing: Theme.space-2;
                            Label { text: part.name; font-size: Theme.small; overflow: elide; horizontal-stretch: 1; }
                            if part.kind != "": Label { text: part.kind; horizontal-stretch: 0; font-size: Theme.small; color: Theme.muted; overflow: elide; }
                            Label { text: part.size; width: 75px; font-size: Theme.small; color: Theme.muted; horizontal-alignment: right; overflow: elide; }
                        }
                        Rectangle { min-height: 18px; vertical-stretch: 0; accessible-role: text; accessible-label: root.detail.path;
                            path-prefix := Label { x: 0px; width: min(self.preferred-width,max(0px,parent.width - path-suffix.preferred-width)); height: parent.height; text: root.detail.path-prefix; font-size: Theme.caption; color: Theme.muted; overflow: elide; accessible-role: none; }
                            path-suffix := Label { x: path-prefix.width; width: min(self.preferred-width,max(0px,parent.width - path-prefix.width)); height: parent.height; text: root.detail.path-suffix; font-size: Theme.caption; color: Theme.muted; overflow: elide; accessible-role: none; }
                        }
                    }
                }
                detail-actions := HorizontalBox { padding: 0px; spacing: Theme.space-2; alignment: end;
                    if root.detail.can-show-copy: ActionButton { text: root.words.show-copy; enabled: root.view.can-copy; clicked => { root.show-copy(); } }
                    ActionButton { text: root.words.show-original; enabled: root.view.can-copy; clicked => { root.show-original(); } }
                    ActionButton { text: root.words.copy-details; enabled: root.view.can-copy; clicked => { root.copy-details(); } }
                }
            }
        }

        footer := Rectangle { height: Theme.footer-height; background: Theme.raised;
            footer-separator := Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
            HorizontalBox { x: root.text-x; width: root.text-width; height: Theme.control-height; y: (parent.height - self.height) / 2; padding: 0px; spacing: 0px;
                if root.view.state == BatchState.checking || root.view.state == BatchState.ready: Label { text: root.words.save-copies; color: Theme.muted; }
                destination-anchor := Rectangle { width: destination-content.preferred-width + ((root.view.state == BatchState.checking || root.view.state == BatchState.ready) ? Theme.space-2 : 0px); height: Theme.control-height;
                    destination-content := HorizontalBox { x: Theme.space-2; width: self.preferred-width; padding: 0px; spacing: 0px;
                if root.view.state == BatchState.checking || root.view.state == BatchState.ready: ActionButton { text: root.view.destination + " ▾"; enabled: root.view.can-add; clicked => { root.destination(); } }
                    }
                }
                if root.view.state == BatchState.removing: VerticalBox { padding: 0px; padding-right: Theme.space-2; spacing: Theme.space-1; horizontal-stretch: 1;
                    Label { text: root.view.progress-text; }
                    ProgressIndicator { progress: root.view.progress; }
                }
                if root.view.state != BatchState.removing: Rectangle { horizontal-stretch: 1; Label { x: (root.view.state == BatchState.checking || root.view.state == BatchState.ready) ? Theme.space-2 : 0px; width: max(0px,parent.width - self.x - ((root.view.state == BatchState.stopped || root.view.state == BatchState.done) ? Theme.space-2 : 0px)); height: parent.height; text: (root.view.state == BatchState.checking || root.view.state == BatchState.ready) ? (root.wide ? root.words.destination-hint : "") : root.view.footer; color: Theme.muted; overflow: elide; } }
                if root.view.state == BatchState.stopped || root.view.state == BatchState.done: ActionButton { text: root.words.start-over; enabled: root.view.can-reset; clicked => { root.reset(); } }
                if root.view.state == BatchState.removing: ActionButton { text: root.view.stopping ? root.words.stopping : root.words.stop; enabled: root.view.can-stop; clicked => { root.stop(); } }
                output-anchor := Rectangle { width: output-content.preferred-width + (root.view.state != BatchState.removing ? Theme.space-2 : 0px); height: Theme.control-height;
                    output-content := HorizontalBox { x: Theme.space-2; width: self.preferred-width; padding: 0px; spacing: 0px;
                if root.view.state != BatchState.removing: PrimaryButton { text: root.view.state == BatchState.done ? root.words.show-output : root.view.primary; enabled: root.view.state == BatchState.done ? root.view.can-output : root.view.can-start; clicked => { if root.view.state == BatchState.done { root.output(); } else { root.start(); } } }
                    }
                }
            }
        }
    }
}
