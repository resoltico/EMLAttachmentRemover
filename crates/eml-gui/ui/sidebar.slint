import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { RunView, Tone } from "models.slint";
import { Theme } from "theme.slint";
import { ActionButton, TextButton, Label, ToneDot } from "controls.slint";
component RunEntry inherits Rectangle {
    in property <RunView> run;
    in property <bool> selected;
    callback activated(); callback context();
    private property <bool> flash;
    changed run => { root.flash = root.run.unseen; }
    Timer { interval: 600ms; running: root.flash; triggered => { root.flash = false; } }
    animate background { duration: 200ms; }
    min-height: 58px; border-radius: 6px;
    background: root.selected || root.flash ? Theme.accent-soft : pointer.has-hover ? Theme.raised : transparent;
    accessible-role: list-item; accessible-label: root.run.label + " · " + root.run.mode;
    accessible-description: root.run.status + (root.run.unseen ? ", new result" : "");
    accessible-item-selectable: true; accessible-item-selected: root.selected;
    accessible-action-default => { root.activated(); }
    HorizontalBox { padding: 8px; spacing: 8px;
        ToneDot { tone: root.run.tone == Tone.running ? Theme.accent : root.run.tone == Tone.ok ? Theme.ok : root.run.tone == Tone.attention ? Theme.warn : Theme.idle; }
        VerticalBox { padding: 0px; spacing: 3px;
            Label { text: root.run.label + " · " + root.run.mode; font-weight: 600; overflow: elide; }
            Label { text: root.run.status; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        if root.run.unseen: ToneDot { tone: Theme.accent; }
    }
    pointer := TouchArea {
        clicked => { root.activated(); }
        pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.context(); } }
    }
}
export component Sidebar inherits Rectangle {
    in property <[RunView]> runs;
    in property <[RunView]> waiting;
    in property <int> selected-run;
    in property <bool> reviewing;
    in property <bool> can-edit;
    callback new-request(); callback select-run(int); callback remove-waiting(int); callback close-run(int);
    width: 230px; background: Theme.sidebar;
    accessible-role: groupbox; accessible-label: "Session navigation";
    VerticalBox { padding: 14px; spacing: 12px;
        Label { text: "REQUEST"; font-size: 12px; font-weight: 600; color: Theme.muted; }
        ActionButton { text: "New Request"; enabled: root.can-edit; clicked => { root.new-request(); } }
        Label { text: "THIS SESSION"; font-size: 12px; font-weight: 600; color: Theme.muted; }
        navigation := FocusScope {
            vertical-stretch: 1;
            key-pressed(event) => {
                if root.runs.length == 0 { return reject; }
                if event.text == Key.DownArrow { root.select-run(min(root.runs.length - 1, root.selected-run + 1)); return accept; }
                if event.text == Key.UpArrow { root.select-run(max(0, root.selected-run - 1)); return accept; }
                if event.text == Key.Home { root.select-run(0); return accept; }
                if event.text == Key.End { root.select-run(root.runs.length - 1); return accept; }
                return reject;
            }
            ScrollView { width: parent.width; height: parent.height; content-width: self.visible-width; content-height: content.preferred-height;
                accessible-role: list; accessible-label: "Session runs";
                content := VerticalBox { width: parent.visible-width; height: self.preferred-height; padding: 0px; spacing: 6px;
                    for run[index] in root.runs: RunEntry { run: run; selected: !root.reviewing && root.selected-run == index;
                        activated => { navigation.focus(); root.select-run(index); }
                        context => { context-index = index; result-menu.show(); }
                    }
                    for run[index] in root.waiting: VerticalBox { padding: 0px; spacing: 2px;
                        RunEntry { run: run; activated => { navigation.focus(); } }
                        TextButton { text: "Remove " + run.label; enabled: root.can-edit; clicked => { root.remove-waiting(index); } }
                    }
                }
            }
        }
    }
    private property <int> context-index;
    result-menu := PopupWindow { width: 180px; height: 52px; x: 20px; y: 100px;
        Rectangle { background: Theme.surface; border-width: 1px; border-color: Theme.border;
            ActionButton { x: 8px; y: 8px; width: parent.width - 16px; height: 32px; text: "Close Result"; enabled: root.context-index >= 0 && root.context-index < root.runs.length && root.runs[root.context-index].tone != Tone.running;
                clicked => { result-menu.close(); root.close-run(root.context-index); }
            }
        }
    }
}
