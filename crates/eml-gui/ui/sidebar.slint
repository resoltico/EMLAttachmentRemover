import { VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";
import { RunView, Tone } from "models.slint";
import { Theme } from "theme.slint";
import { ActionButton, TextButton, IconButton, IconKind, Label, ToneDot, UiMetrics } from "controls.slint";
component RunEntry inherits Rectangle {
    in property <RunView> run;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> enabled;
    callback activated(); callback context(length,length); callback remove();
    height: UiMetrics.sidebar-row-height; border-radius: 6px;
    private property <bool> flash;
    changed run => { root.flash = root.run.unseen; }
    Timer { interval: 600ms; running: root.flash; triggered => { root.flash = false; } }
    background: root.selected || root.flash ? Theme.accent-soft : pointer.has-hover ? Theme.raised : transparent;
    animate background { duration: 200ms; }
    border-width: root.focused ? 1px : 0px; border-color: Theme.accent;
    accessible-role: list-item; accessible-label: root.run.label + " · " + root.run.mode;
    accessible-id: root.run.token; accessible-enabled: root.enabled;
    accessible-description: root.run.status + (root.run.unseen ? ", new result" : "");
    accessible-item-selectable: true; accessible-item-selected: root.selected;
    accessible-action-default => { if root.enabled { root.activated(); } }
    pointer := TouchArea { enabled: root.enabled;
        clicked => { root.activated(); }
        pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
    }
    HorizontalBox { width: parent.width; height: parent.height; padding: 8px; spacing: 8px;
        VerticalBox { width: 8px; padding: 0px; spacing: 0px; alignment: center; ToneDot { ring: root.run.tone == Tone.stopped; tone: root.run.tone == Tone.running ? Theme.accent : root.run.tone == Tone.ok ? Theme.ok : root.run.tone == Tone.attention ? Theme.warn : Theme.idle; } }
        VerticalBox { padding: 0px; spacing: 3px; alignment: center; horizontal-stretch: 1;
            Label { text: root.run.label + " · " + root.run.mode; font-weight: 600; overflow: elide; }
            Label { text: root.run.status; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        if root.run.unseen: VerticalBox { width: 8px; padding: 0px; spacing: 0px; alignment: center; ToneDot { tone: Theme.accent; } }
        if root.run.waiting: IconButton { text: "Remove " + root.run.label; icon: IconKind.remove; enabled: root.enabled; clicked => { root.remove(); } }
    }
}
export component Sidebar inherits Rectangle {
    in property <[RunView]> runs;
    in property <int> selected-index;
    in property <int> unseen-count;
    in property <bool> can-edit;
    callback new-request(); callback select-session(string); callback close-session(string); callback switch-pane();
    callback focus-navigation();
    focus-navigation => { if root.runs.length > 0 { navigation.focus(); } else { new-request-button.focus(); } }
    width: 230px; background: Theme.sidebar;
    accessible-role: groupbox; accessible-label: "Session navigation";
    changed can-edit => { if !root.can-edit { menu.close(); } }
    private property <length> scroll-y;
    private property <length> context-x;
    private property <length> context-y;
    function open-context(index:int, x:length, y:length) {
        if !root.can-edit || index < 0 || index >= root.runs.length { return; }
        let run = root.runs[index];
        root.context-token = run.token;
        root.context-waiting = run.waiting;
        root.context-closable = run.closable;
        root.context-x = x;
        root.context-y = y;
        menu.show();
    }
    function select-index(index:int) {
        if index >= 0 && index < root.runs.length { root.select-session(root.runs[index].token); }
    }
    function reveal-selected() {
        if root.selected-index < 0 || root.selected-index >= root.runs.length { return; }
        let top = root.selected-index * UiMetrics.sidebar-row-height;
        let bottom = top + UiMetrics.sidebar-row-height;
        if root.scroll-y + top < 0px { root.scroll-y = -top; }
        if root.scroll-y + bottom > session-list.visible-height { root.scroll-y = session-list.visible-height - bottom; }
        root.scroll-y = max(min(0px,session-list.visible-height - root.runs.length * UiMetrics.sidebar-row-height),min(0px,root.scroll-y));
    }
    changed selected-index => { root.reveal-selected(); }
    private property <length> visible-height: session-list.visible-height;
    changed visible-height => { root.reveal-selected(); }
    FocusScope { width: parent.width; height: parent.height; focus-on-tab-navigation: false;
        key-pressed(event) => {
            if root.can-edit && event.text == Key.Tab && (UiMetrics.macos ? event.modifiers.meta : event.modifiers.control) { root.switch-pane(); return accept; }
            return reject;
        }
        VerticalBox { width: parent.width; height: parent.height; padding: 14px; spacing: 12px;
            Label { text: "REQUEST"; font-size: 12px; font-weight: 600; color: Theme.muted; }
            new-request-button := ActionButton { text: "New Request"; enabled: root.can-edit; clicked => { root.new-request(); } }
            Label { text: "THIS SESSION" + (root.unseen-count > 0 ? " · " + root.unseen-count + " NEW" : ""); font-size: 12px; font-weight: 600; color: Theme.muted; }
            navigation := FocusScope { vertical-stretch: 1; min-height: UiMetrics.sidebar-row-height + UiMetrics.scroll-inset * 2; enabled: root.can-edit && root.runs.length > 0;
                key-pressed(event) => {
                    if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                        root.open-context(root.selected-index, 14px, session-list.absolute-position.y - root.absolute-position.y + root.scroll-y + (root.selected-index + 1) * UiMetrics.sidebar-row-height);
                        return accept;
                    }
                    if event.text == Key.DownArrow { root.select-index(min(root.runs.length - 1,root.selected-index + 1)); return accept; }
                    if event.text == Key.UpArrow { root.select-index(max(0,root.selected-index - 1)); return accept; }
                    if event.text == Key.Home { root.select-index(0); return accept; }
                    if event.text == Key.End { root.select-index(root.runs.length - 1); return accept; }
                    if event.text == Key.PageDown { root.select-index(min(root.runs.length - 1,root.selected-index + max(1,floor(session-list.visible-height / UiMetrics.sidebar-row-height)))); return accept; }
                    if event.text == Key.PageUp { root.select-index(max(0,root.selected-index - max(1,floor(session-list.visible-height / UiMetrics.sidebar-row-height)))); return accept; }
                    return reject;
                }
                session-list := ListView { width: parent.width; height: parent.height; content-width: self.visible-width; content-y <=> root.scroll-y;
                    accessible-role: list; accessible-label: "Session runs";
                    for run[index] in root.runs: RunEntry {
                        run: run; enabled: root.can-edit; selected: index == root.selected-index;
                        focused: navigation.has-focus && index == root.selected-index;
                        activated => { navigation.focus(); root.select-session(run.token); }
                        remove => { root.close-session(run.token); }
                        context(x,y) => { root.open-context(index, x - root.absolute-position.x, y - root.absolute-position.y); }
                    }
                }
            }
        }
    }
    private property <string> context-token;
    private property <bool> context-waiting;
    private property <bool> context-closable;
    menu := PopupWindow { width: 190px; height: 52px;
        x: max(8px,min(root.context-x, root.width - self.width - 8px));
        y: root.context-y + self.height <= root.height - 8px ? max(8px,root.context-y) : max(8px,root.context-y - self.height);
        Rectangle { background: Theme.surface; border-width: 1px; border-color: Theme.border;
            FocusScope { width: parent.width; height: parent.height; key-pressed(event) => { if event.text == Key.Escape { menu.close(); return accept; } return reject; }
                ActionButton { x: 8px; y: 8px; width: parent.width - 16px; height: 32px;
                    text: root.context-waiting ? "Remove from Queue" : "Close Result";
                    enabled: root.can-edit && (root.context-waiting || root.context-closable);
                    clicked => { menu.close(); root.close-session(root.context-token); }
                }
            }
        }
    }
}
