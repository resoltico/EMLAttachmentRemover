import { HorizontalBox, VerticalBox, ScrollView, ListView, ProgressIndicator, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PathView, ItemView, ChipView, DetailView, CountView, RemovalView, Tone } from "models.slint";
import { ActionButton, PrimaryButton, TextButton, IconButton, Icon, IconKind, Label, FileName, ToneDot, Chip, UiMetrics } from "controls.slint";
component ColumnButton inherits TextButton {
    in property <bool> sorted;
    in property <bool> descending;
    min-width: 0px; horizontal-stretch: 1; horizontal-inset: 0px; trailing-inset: 20px;
    if root.sorted: Icon { kind: IconKind.chevron; x: parent.width - 18px; y: (parent.height - self.height) / 2;
        commands: root.descending ? "M6 9 L12 15 L18 9" : "M6 15 L12 9 L18 15";
    }
}
component ResultsTable inherits VerticalBox {
    in property <bool> enabled;
    in property <[ItemView]> items;
    in property <int> selected-item;
    in property <int> selected-visible-row;
    in property <int> sort-column;
    in property <bool> sort-descending;
    in property <bool> show-folder;
    in property <bool> can-copy;
    in property <length> ui-size;
    in property <string> context;
    in property <string> empty-message;
    in property <length> header-height;
    in-out property <length> scroll-y;
    callback select-item(int); callback sort-results(int); callback navigate(int,int);
    callback type-select(string); callback copy-path();
    padding: 0px; spacing: 0px;
    private property <length> row-height: UiMetrics.message-row-height;
    private property <length> folder-width: min(150px,max(80px,root.width * 0.23));
    private property <length> outcome-width: min(190px,max(128px,root.width * 0.3));
    private property <string> search;
    changed context => { root.search = ""; }
    search-reset := Timer { interval: 1s; running: root.search != ""; triggered => { root.search = ""; } }
    function reveal-selected() {
        if root.selected-visible-row < 0 || root.selected-visible-row >= root.items.length { return; }
        let top = root.selected-visible-row * root.row-height;
        let bottom = top + root.row-height;
        if root.scroll-y + top < 0px { root.scroll-y = -top; }
        if root.scroll-y + bottom > message-list.visible-height { root.scroll-y = message-list.visible-height - bottom; }
        root.scroll-y = max(min(0px,message-list.visible-height - root.items.length * root.row-height),min(0px,root.scroll-y));
    }
    changed selected-visible-row => { root.reveal-selected(); }
    private property <length> visible-height: message-list.visible-height;
    changed visible-height => { root.reveal-selected(); }
    HorizontalBox { padding: 0px; padding-left: 8px + UiMetrics.scroll-inset; padding-right: 8px + UiMetrics.scroll-inset; spacing: 8px;
        height: root.header-height;
        Rectangle { width: 8px; }
        ColumnButton { enabled: root.enabled; text: "Message"; sorted: root.sort-column == 0; descending: root.sort-descending; clicked => { root.sort-results(0); } }
        if root.show-folder: ColumnButton { enabled: root.enabled; text: "Folder"; width: root.folder-width; horizontal-stretch: 0; sorted: root.sort-column == 1; descending: root.sort-descending; clicked => { root.sort-results(1); } }
        ColumnButton { enabled: root.enabled; text: "Outcome"; width: root.outcome-width; horizontal-stretch: 0; sorted: root.sort-column == 2; descending: root.sort-descending; clicked => { root.sort-results(2); } }
    }
    keys := FocusScope {
        min-height: UiMetrics.message-row-height * 2 + UiMetrics.scroll-inset * 2; vertical-stretch: 1;
        enabled: root.items.length > 0;
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "c" || event.text == "C") { if root.can-copy { root.copy-path(); } return accept; }
            if event.text == Key.DownArrow { root.navigate(1,1); return accept; }
            if event.text == Key.UpArrow { root.navigate(-1,1); return accept; }
            if event.text == Key.Home { root.navigate(-2,1); return accept; }
            if event.text == Key.End { root.navigate(2,1); return accept; }
            if event.text == Key.PageDown { root.navigate(3,max(1,floor(message-list.visible-height / root.row-height))); return accept; }
            if event.text == Key.PageUp { root.navigate(-3,max(1,floor(message-list.visible-height / root.row-height))); return accept; }
            if event.text == Key.Tab || event.text == Key.Return || event.text == Key.Escape || event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.Backspace { return reject; }
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && event.text != "" {
                root.search += event.text; search-reset.restart(); root.type-select(root.search); return accept;
            }
            return reject;
        }
        message-list := ListView { width: parent.width; height: parent.height; content-width: self.visible-width; content-y <=> root.scroll-y;
            accessible-role: list; accessible-label: "Message results";
            for item in root.items: Rectangle {
                height: root.row-height; border-radius: 6px;
                background: item.original-index == root.selected-item ? Theme.accent-soft : pointer.has-hover ? Theme.raised : transparent;
                border-width: keys.has-focus && item.original-index == root.selected-item ? 1px : 0px; border-color: Theme.accent;
                accessible-role: list-item; accessible-label: item.path.full;
                accessible-description: item.status + "; " + item.folder;
                accessible-item-selectable: true; accessible-item-selected: item.original-index == root.selected-item;
                accessible-action-default => { keys.focus(); root.select-item(item.original-index); }
                HorizontalBox { width: parent.width; height: parent.height; padding: 2px; padding-left: 8px; padding-right: 8px; spacing: 8px;
                    VerticalBox { width: 8px; padding: 0px; spacing: 0px; alignment: center; ToneDot { ring: item.tone == Tone.stopped; tone: item.tone == Tone.attention ? Theme.warn : item.tone == Tone.ok ? Theme.ok : Theme.idle; } }
                    FileName { path: item.path; text-size: root.ui-size; height: max(0px,parent.height - 4px); }
                    if root.show-folder: Label { text: item.folder; width: root.folder-width; horizontal-stretch: 0; overflow: elide; color: Theme.muted; }
                    Label { text: item.status; width: root.outcome-width; horizontal-stretch: 0; overflow: elide; color: item.attention ? Theme.bad : Theme.text; }
                }
                pointer := TouchArea { clicked => { keys.focus(); root.select-item(item.original-index); } }
            }
        }
        if root.items.length == 0: Label { x: 12px; y: 12px; width: parent.width - 24px; text: root.empty-message; color: Theme.muted; wrap: word-wrap; }
    }
    forward-focus: keys;
}
component Inspector inherits Rectangle {
    in property <bool> has-item;
    in property <PathView> source;
    in property <PathView> destination;
    in property <string> verdict;
    in property <string> guidance;
    in property <bool> attention;
    in property <bool> can-reveal;
    in property <bool> can-show-copy;
    in property <bool> can-reveal-original;
    in property <bool> can-copy-source;
    in property <bool> can-copy-destination;
    in property <bool> busy;
    in property <[DetailView]> details;
    in property <[CountView]> byte-counts;
    in property <[RemovalView]> removals;
    in property <[DetailView]> stripped;
    in property <string> removal-heading;
    in property <string> field-heading;
    in property <length> ui-size;
    in-out property <bool> expanded;
    in-out property <length> scroll-y;
    callback reveal(); callback reveal-original(); callback copy-source(); callback copy-destination();
    background: Theme.raised; border-radius: 8px;
    accessible-role: groupbox; accessible-label: "Message inspector";
    ScrollView { x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px;
        content-width: self.visible-width; content-height: content.height; content-y <=> root.scroll-y;
        accessible-role: list; accessible-label: "Message details";
        content := VerticalBox { width: parent.visible-width; height: max(self.min-height,self.preferred-height); padding: 0px; spacing: 10px;
            if !root.has-item: Label { text: "Select a message to see its details."; color: Theme.muted; wrap: word-wrap; }
            if root.has-item: FileName { path: root.source; text-size: root.ui-size; }
            if root.has-item: Label { text: root.source.directory; color: Theme.muted; font-size: max(12px,root.ui-size * 0.9); overflow: elide; }
            if root.has-item: Label { width: parent.width; height: self.preferred-height; text: root.verdict; font-weight: 600; color: root.attention ? Theme.bad : Theme.text; wrap: word-wrap; }
            if root.has-item && root.guidance != "": Label { width: parent.width; height: self.preferred-height; text: root.guidance; wrap: word-wrap; }
            if root.has-item && root.removals.length > 0: VerticalBox { padding: 0px; spacing: 8px;
                Label { text: root.removal-heading; font-weight: 600; wrap: word-wrap; }
                for part in root.removals: Label { text: (part.filename != "" ? part.filename : part.media) + " · " + part.media + " · " + part.bytes + " bytes"; wrap: word-wrap; }
            }
            if root.has-item: HorizontalBox { padding: 0px; spacing: 8px;
                if root.can-reveal: ActionButton { text: "Show Copy"; enabled: root.can-show-copy; clicked => { root.reveal(); } }
                if !root.can-reveal: ActionButton { text: "Show Original"; enabled: root.can-reveal-original; clicked => { root.reveal-original(); } }
                TextButton { text: "Copy Path"; enabled: root.can-copy-source; accessible-description: "Copy the original message’s native path."; clicked => { root.copy-source(); } }
            }
            if root.has-item: TextButton { text: root.expanded ? "Hide Technical Details" : "Technical Details"; accessible-label: "Technical details"; expandable: true; expanded: root.expanded; clicked => { root.expanded = !root.expanded; } }
            if root.has-item && root.expanded: VerticalBox { width: parent.width; height: self.preferred-height; padding: 0px; spacing: 8px; vertical-stretch: 0;
                Label { text: "Source"; font-weight: 600; }
                Label { text: root.source.full; wrap: word-wrap; }
                TextButton { text: "Copy Source Path"; enabled: root.can-copy-source; clicked => { root.copy-source(); } }
                if root.destination.full != "": Label { text: "Destination"; font-weight: 600; }
                if root.destination.full != "": Label { text: root.destination.full; wrap: word-wrap; }
                if root.destination.full != "": TextButton { text: "Copy Destination Path"; enabled: root.can-copy-destination && !root.busy; clicked => { root.copy-destination(); } }
                for metric in root.byte-counts: Label { text: metric.label + ": " + metric.value; }
                for part in root.removals: Label { text: part.reason; wrap: word-wrap; }
                for line in root.details: Label { text: line.text; wrap: word-wrap; }
                if root.stripped.length > 0: Label { text: root.field-heading; font-weight: 600; }
                for field in root.stripped: Label { text: field.text; wrap: word-wrap; }
            }
        }
    }
}
export component RunPane inherits ScrollView {
    in property <string> run-label;
    in property <string> run-status;
    in property <string> run-title;
    in property <string> run-context;
    in property <string> run-notice;
    in property <string> operation-feedback;
    in property <string> operation-label;
    in property <string> operation-details;
    in property <string> report-details;
    in property <[DetailView]> report-diagnostics;
    in property <bool> report-running;
    in property <bool> report-loading;
    in property <string> report-load-notice;
    in property <bool> closing;
    in property <bool> can-stop;
    in property <bool> can-force;
    in property <bool> stop-requested;
    in property <bool> can-export;
    in property <bool> can-dismiss;
    in property <bool> can-review;
    in property <bool> can-create;
    in property <bool> is-check-result;
    in property <bool> can-filter;
    in property <bool> can-sort;
    in property <bool> can-show-copy;
    in property <bool> can-reveal-report;
    in property <Tone> operation-tone;
    callback reveal-report(); callback show-output();
    in property <bool> can-reveal-output;
    in property <string> reveal-output-label;
    in property <[string]> output-roots;
    in property <int> extra-output-roots;
    in property <string> review-label;
    in property <int> work-total;
    in property <int> work-completed;
    in property <string> progress-label;
    in property <string> estimate;
    in property <[ChipView]> chips;
    in property <[ItemView]> items;
    in property <int> filter;
    in property <int> sort-column;
    in property <bool> sort-descending;
    in property <int> selected-item;
    in property <int> selected-visible-row;
    in property <PathView> item-source-path;
    in property <PathView> item-destination-path;
    in property <string> item-status;
    in property <string> item-headline;
    in property <string> item-guidance;
    in property <bool> item-attention;
    in property <bool> has-item;
    in property <bool> can-reveal;
    in property <bool> can-reveal-original;
    in property <bool> can-copy-source;
    in property <bool> can-copy-destination;
    in property <bool> native-open-pending;
    in property <[DetailView]> details;
    in property <[CountView]> byte-counts;
    in property <[RemovalView]> removals;
    in property <[DetailView]> stripped;
    in property <string> removal-heading;
    in property <string> field-heading;
    in property <length> ui-size;
    in property <length> window-width;
    in-out property <bool> details-expanded;
    in-out property <length> details-scroll-y;
    in-out property <length> messages-scroll-y;
    callback stop(); callback force-stop(); callback review-request(); callback create-from-check();
    callback export-report(); callback dismiss(); callback reveal-output(int);
    callback filter-results(int); callback sort-results(int); callback select-item(int);
    callback navigate-message(int,int); callback type-select(string);
    callback reveal(); callback reveal-original(); callback copy-source-path(); callback copy-destination-path();
    min-height: 100px;
    content-width: self.visible-width; content-height: content.height;
    accessible-role: groupbox; accessible-label: "Run workspace"; accessible-description: root.run-status;
    private property <bool> banner-details;
    changed run-label => { actions.close(); root.banner-details = false; }
    content := VerticalBox { width: parent.visible-width; height: max(parent.visible-height,max(self.min-height,self.preferred-height)); padding: 0px; spacing: 12px;
        header := VerticalBox { padding: 0px; spacing: 8px; vertical-stretch: 0;
            HorizontalBox { padding: 0px; spacing: 8px;
                VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                    Label { text: root.run-title; font-size: 22px; font-weight: 700; wrap: word-wrap; accessible-live-region: polite; }
                    Label { text: root.run-context; color: Theme.muted; overflow: elide; }
                }
                if root.report-running: ActionButton { text: root.stop-requested ? "Stopping…" : "Stop"; enabled: root.can-stop; clicked => { root.stop(); } }
                if root.report-running && root.can-force: TextButton { text: "Force Stop…"; danger: true; clicked => { root.force-stop(); } }
                if !root.report-running: TextButton { text: root.review-label; enabled: root.can-review; clicked => { root.review-request(); } }
                if !root.report-running && root.is-check-result: PrimaryButton { text: "Create Copies…"; enabled: root.can-create; clicked => { root.create-from-check(); } }
                if !root.report-running && !root.is-check-result: PrimaryButton { text: root.reveal-output-label; enabled: root.can-reveal-output; clicked => { root.show-output(); } }
                IconButton { text: "More actions"; icon: IconKind.ellipsis; clicked => { actions.show(); } }
            }
            if root.report-running: VerticalBox { padding: 0px; spacing: 6px;
                HorizontalBox { padding: 0px;
                    Label { text: root.progress-label; color: Theme.muted; }
                    Label { text: root.estimate; color: Theme.muted; horizontal-alignment: right; }
                }
                ProgressIndicator { height: 6px; progress: root.work-total > 0 ? root.work-completed * 1.0 / root.work-total : 0; indeterminate: root.work-total == 0;
                    accessible-label: root.progress-label;
                }
            }
            if root.run-notice != "" || root.operation-feedback != "": VerticalBox { padding: 8px; spacing: 6px;
                HorizontalBox { padding: 0px; spacing: 8px;
                    if root.run-notice != "" || root.operation-tone == Tone.attention: Icon { kind: IconKind.warning; stroke: Theme.warn; }
                    Label { text: (root.operation-feedback != "" ? (root.operation-label != "" && root.operation-label != "Operation status" ? root.operation-label + ": " : "") + root.operation-feedback : "") + (root.operation-feedback != "" && root.run-notice != "" ? "\n" : "") + root.run-notice; wrap: word-wrap; color: root.run-notice != "" || root.operation-tone == Tone.attention ? Theme.warn : root.operation-tone == Tone.ok ? Theme.ok : Theme.text; accessible-live-region: polite; }
                    if root.can-reveal-report: TextButton { text: "Show"; clicked => { root.reveal-report(); } }
                    if root.report-diagnostics.length > 0 || root.report-details != "" || root.operation-details != "": TextButton { text: root.banner-details ? "Hide Details" : "Details"; expanded: root.banner-details; expandable: true; clicked => { root.banner-details = !root.banner-details; } }
                }
                if root.banner-details: ScrollView { preferred-height: 80px; max-height: 80px; min-height: 0px; content-width: self.visible-width; content-height: diagnostic-content.height;
                    diagnostic-content := VerticalBox { width: parent.visible-width; height: max(self.min-height,self.preferred-height); padding: 0px; spacing: 4px;
                        for line in root.report-diagnostics: Label { text: line.text; wrap: word-wrap; }
                        if root.report-details != "": Label { text: root.report-details; wrap: word-wrap; }
                        if root.operation-details != "": Label { text: root.operation-details; wrap: word-wrap; }
                    }
                }
            }
        }
        filters := ScrollView { visible: root.chips.length > 0; height: root.chips.length > 0 ? max(32px,root.ui-size * 1.4 + 10px) + UiMetrics.scroll-inset * 2 : 0px;
            content-width: filter-row.preferred-width; content-height: self.visible-height;
            accessible-role: list; accessible-label: "Outcome filters";
            filter-row := HorizontalBox { width: self.preferred-width; height: parent.visible-height; padding: 0px; spacing: 8px;
                for chip in root.chips: Chip { enabled: root.can-filter; text: chip.label + " " + chip.value; selected: chip.active; clicked => { root.filter-results(chip.active ? 0 : chip.filter); } }
            }
        }
        results := Rectangle {
            private property <bool> stacked: self.width < 760px;
            private property <length> inspector-width: root.window-width < 900px ? 260px : 320px;
            private property <length> table-header-height: max(32px,root.ui-size * 1.4 + 10px);
            min-height: self.stacked ? self.table-header-height + UiMetrics.message-row-height * 2 + UiMetrics.scroll-inset * 2 + 160px + 12px : 140px;
            preferred-height: max(self.min-height,root.visible-height - header.preferred-height - filters.height - 24px);
            vertical-stretch: 1;
            table := ResultsTable {
                x: 0px; y: 0px;
                width: parent.stacked ? parent.width : parent.width - parent.inspector-width - 16px;
                height: parent.stacked ? min(parent.height - 172px,max(parent.table-header-height + UiMetrics.message-row-height * 2 + UiMetrics.scroll-inset * 2,parent.height * 0.56)) : parent.height;
                header-height: parent.table-header-height; items: root.items; selected-item: root.selected-item; selected-visible-row: root.selected-visible-row;
                enabled: root.can-sort; sort-column: root.sort-column; sort-descending: root.sort-descending; show-folder: root.window-width >= 900px;
                ui-size: root.ui-size; context: root.run-label; can-copy: root.can-copy-source;
                empty-message: root.report-loading ? root.report-load-notice : "No per-message results are available in this view.";
                scroll-y <=> root.messages-scroll-y;
                select-item(index) => { root.select-item(index); }
                sort-results(column) => { root.sort-results(column); }
                navigate(direction,page) => { root.navigate-message(direction,page); }
                type-select(prefix) => { root.type-select(prefix); }
                copy-path() => { root.copy-source-path(); }
            }
            Inspector {
                x: parent.stacked ? 0px : table.width + 16px;
                y: parent.stacked ? table.height + 12px : 0px;
                width: parent.stacked ? parent.width : parent.inspector-width;
                height: parent.stacked ? parent.height - table.height - 12px : parent.height;
                has-item: root.has-item; source: root.item-source-path; destination: root.item-destination-path;
                verdict: root.item-headline; guidance: root.item-guidance; attention: root.item-attention;
                can-reveal: root.can-reveal; can-show-copy: root.can-show-copy; can-reveal-original: root.can-reveal-original;
                can-copy-source: root.can-copy-source; can-copy-destination: root.can-copy-destination;
                busy: root.native-open-pending || root.closing; details: root.details; byte-counts: root.byte-counts;
                removals: root.removals; stripped: root.stripped; removal-heading: root.removal-heading; field-heading: root.field-heading;
                ui-size: root.ui-size; expanded <=> root.details-expanded; scroll-y <=> root.details-scroll-y;
                reveal() => { root.reveal(); } reveal-original() => { root.reveal-original(); }
                copy-source() => { root.copy-source-path(); } copy-destination() => { root.copy-destination-path(); }
            }
        }
    }
    actions := PopupWindow { x: max(0px,root.width - self.width); y: 52px; width: 190px; height: 100px;
        Rectangle { background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 8px;
            VerticalBox { padding: 8px; spacing: 8px;
                TextButton { text: "Save Report…"; enabled: root.can-export && !root.closing; clicked => { actions.close(); root.export-report(); } }
                TextButton { text: "Close Result"; enabled: root.can-dismiss && !root.closing; clicked => { actions.close(); root.dismiss(); } }
            }
        }
    }

}
