import { Button, Palette, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { WidgetMetrics } from "widget-metrics.slint";

// Application relationships, rather than independent per-window magic numbers.
export global UiMetrics {
    out property <length> sidebar-row-height: 58px;
    out property <bool> macos: WidgetMetrics.macos;
    out property <length> message-row-height: 34px;
    out property <length> scroll-inset: WidgetMetrics.scroll-inset;
    out property <length> overlay-scrollbar-width: WidgetMetrics.overlay-scrollbar-width;
    out property <length> gutter: 24px;
    out property <length> inset: 16px;
    out property <length> gap: 8px;
    out property <length> label-gap: 4px;
    out property <brush> attention: Theme.bad;
}
export component ActionButton inherits Button {
    min-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    preferred-width: self.min-width;
    preferred-height: self.min-height;
    max-height: self.min-height;
}
export component PrimaryButton inherits ActionButton { primary: true; }
// Fluent has no borderless button variant. Keep the small utility/disclosure role
// separate from committing buttons, with the same keyboard and AX activation.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> show-caption: true;
    in property <TextHorizontalAlignment> text-alignment: left;
    in property <length> leading-inset;
    in property <length> trailing-inset;
    in property <length> horizontal-inset: 8px;
    in property <bool> enabled: true;
    in property <bool> expanded;
    in property <bool> expandable;
    in property <bool> danger;
    out property <bool> has-focus: keys.has-focus;
    callback clicked();
    min-width: (root.show-caption ? caption.preferred-width : 0px) + root.horizontal-inset * 2 + root.leading-inset + root.trailing-inset;
    min-height: max(32px, root.show-caption ? caption.preferred-height + 10px : 32px);
    preferred-width: self.min-width;
    preferred-height: self.min-height;
    max-height: self.min-height;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 4px;
    background: pointer.has-hover && root.enabled ? Palette.alternate-background : transparent;
    border-width: keys.has-focus && root.enabled ? 1px : 0px;
    border-color: Palette.accent-background;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-expandable: root.expandable;
    accessible-expanded: root.expanded;
    accessible-action-default => { if root.enabled { keys.focus(); root.clicked(); } }
    forward-focus: keys;
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    caption := Text {
        visible: root.show-caption;
        text: root.text; overflow: elide; color: root.danger ? UiMetrics.attention : Theme.text;
        opacity: root.enabled ? 1 : 0.5;
        x: root.horizontal-inset + root.leading-inset;
        width: max(0px, parent.width - root.horizontal-inset * 2 - root.leading-inset - root.trailing-inset); height: parent.height;
        horizontal-alignment: root.text-alignment;
        vertical-alignment: center;
        accessible-role: none;
    }
    pointer := TouchArea { enabled: root.enabled; clicked => { keys.focus(); root.clicked(); } }
}

export component Label inherits Text { vertical-stretch: 0; min-width: 0px; vertical-alignment: center; color: Theme.text; accessible-role: text; accessible-label: self.text; }
// Text measures its own glyphs; the suffix stays visible as the prefix elides.
export component FileName inherits Rectangle {
    in property <PathView> path;
    in property <length> text-size: 14px;
    height: max(22px, root.text-size * 1.4);
    horizontal-stretch: 1;
    min-width: 0px;
    accessible-role: text;
    accessible-label: root.path.full;
    private property <bool> clipped-suffix: suffix-text.preferred-width > root.width;
    prefix := Text {
        text: root.clipped-suffix ? "…" : root.path.prefix;
        color: Theme.text; font-size: root.text-size;
        x: 0px; height: parent.height;
        width: root.clipped-suffix ? min(self.preferred-width,root.width) : min(self.preferred-width,max(0px,root.width - suffix-area.width));
        overflow: elide; vertical-alignment: center;
        accessible-role: none;
    }
    suffix-area := Rectangle {
        x: prefix.width;
        width: min(suffix-text.preferred-width,max(0px,root.width - (root.clipped-suffix ? prefix.preferred-width : 0px)));
        height: parent.height; clip: true;
        accessible-role: none;
        suffix-text := Text {
            text: root.path.suffix; color: Theme.text; font-size: root.text-size;
            x: min(0px,parent.width - self.preferred-width); width: self.preferred-width;
            height: parent.height; vertical-alignment: center; overflow: clip;
            accessible-role: none; accessible-label: "";
        }
    }
    Tooltip { text: @markdown("\{root.path.full}"); }
}
export component PathLabel inherits VerticalBox {
    in property <PathView> path;
    in property <length> text-size: 14px;
    padding: 0px; spacing: 0px; horizontal-stretch: 1; min-width: 0px;
    FileName { path: root.path; text-size: root.text-size; }
    Label { text: root.path.directory; font-size: max(12px, root.text-size * 0.9); opacity: 0.72; overflow: elide; min-width: 0px; Tooltip { text: @markdown("\{root.path.full}"); } }
}

export enum IconKind { folder, file, remove, chevron, ellipsis, status, warning }
export component Icon inherits Path {
    in property <IconKind> kind;
    width: 16px; height: 16px;
    viewbox-width: 24; viewbox-height: 24;
    stroke: Theme.text; stroke-width: 1.6px; fill: transparent;
    commands: kind == IconKind.folder ? "M2 6 L9 6 L11 8 L22 8 L22 20 L2 20 Z"
        : kind == IconKind.file ? "M5 2 L14 2 L20 8 L20 22 L5 22 Z M14 2 L14 8 L20 8"
        : kind == IconKind.remove ? "M6 6 L18 18 M18 6 L6 18"
        : kind == IconKind.chevron ? "M6 9 L12 15 L18 9"
        : kind == IconKind.ellipsis ? "M4 12 L6 12 M11 12 L13 12 M18 12 L20 12"
        : kind == IconKind.warning ? "M12 2 L23 22 L1 22 Z M12 8 L12 15 M12 18 L12 19"
        : "M4 12 L10 18 L20 6";
}
export component IconButton inherits TextButton {
    in property <IconKind> icon;
    show-caption: false;
    min-width: 32px; preferred-width: 32px; max-width: 32px;
    // Label remains available to accessibility; the vector supplies the visual.
    Icon { kind: root.icon; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}
export component Chip inherits TextButton {
    in property <bool> selected;
    accessible-checkable: true;
    accessible-checked: root.selected;
    background: root.selected ? Theme.accent-soft : Theme.surface;
    border-width: root.has-focus ? 2px : 1px;
    border-color: root.selected || root.has-focus ? Theme.accent : Theme.border;
}
export component DestinationButton inherits TextButton {
    in property <PathView> path;
    in property <length> text-size: 13px;
    show-caption: false;
    text: root.path.full;
    min-width: 120px; preferred-width: 220px; horizontal-stretch: 1;
    trailing-inset: 22px;
    background: Theme.raised; border-width: 1px; border-radius: 6px;
    border-color: root.has-focus ? Theme.accent : Theme.border;
    Icon { kind: IconKind.chevron; x: parent.width - 22px; y: (parent.height - self.height) / 2; }
    FileName { path: root.path; x: root.horizontal-inset; width: max(0px,parent.width - root.horizontal-inset * 2 - root.trailing-inset); height: parent.height; text-size: root.text-size; }
    accessible-expandable: true;
}
export component ToneDot inherits Rectangle {
    in property <color> tone;
    in property <bool> ring;
    width: 8px; height: 8px; border-radius: 4px;
    background: root.ring ? transparent : root.tone;
    border-width: root.ring ? 1px : 0px; border-color: root.tone;
    accessible-role: none;
}
export component Segmented inherits Rectangle {
    in property <bool> check-only;
    in property <bool> enabled: true;
    callback changed(bool);
    min-height: segments.min-height;
    border-radius: 8px; background: Theme.raised; border-width: 1px; border-color: Theme.border;
    accessible-role: tab-list; accessible-label: "Action";
    segments := HorizontalBox { width: parent.width; height: parent.height; padding: 2px; spacing: 2px;
        TextButton { text-alignment: center; text: "Create copies"; enabled: root.enabled; min-width: 0px; horizontal-stretch: 1;
            background: !root.check-only ? Theme.surface : transparent; border-radius: 6px;
            accessible-role: tab; accessible-item-selected: !root.check-only; accessible-checkable: true; accessible-checked: !root.check-only;
            clicked => { root.changed(false); }
        }
        TextButton { text-alignment: center; text: "Check only"; enabled: root.enabled; min-width: 0px; horizontal-stretch: 1;
            background: root.check-only ? Theme.surface : transparent; border-radius: 6px;
            accessible-role: tab; accessible-item-selected: root.check-only; accessible-checkable: true; accessible-checked: root.check-only;
            clicked => { root.changed(true); }
        }
    }
}
