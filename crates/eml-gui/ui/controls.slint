import { Theme } from "theme.slint";
import { WidgetMetrics } from "widget-metrics.slint";

// Application relationships, rather than independent per-window magic numbers.
export global UiMetrics {
    out property <length> scroll-inset: WidgetMetrics.scroll-inset;
}
// One keyboard and accessibility implementation; command and link styles differ.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <TextHorizontalAlignment> text-alignment: left;
    in property <bool> enabled: true;
    in property <bool> expanded;
    in property <bool> expandable;
    in property <color> foreground: Theme.text;
    out property <bool> has-focus: keys.has-focus;
    out property <bool> hovered: pointer.has-hover;
    out property <bool> pressed: pointer.pressed;
    callback clicked();
    min-width: caption.preferred-width + Theme.space-2 * 2;
    min-height: max(Theme.control-height, caption.preferred-height + Theme.space-2);
    preferred-width: self.min-width;
    preferred-height: self.min-height;
    max-height: self.min-height;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: Theme.radius-control;
    background: pointer.has-hover && root.enabled ? Theme.raised : transparent;
    border-width: keys.has-focus && root.enabled ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-expandable: root.expandable;
    accessible-expanded: root.expanded;
    accessible-action-default => { if root.enabled { keys.focus(); root.clicked(); } }
    forward-focus: keys;
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    caption := Text {
        text: root.text; overflow: elide; color: root.foreground;
        opacity: root.enabled ? 1 : 0.5;
        x: Theme.space-2;
        width: max(0px, parent.width - Theme.space-2 * 2); height: parent.height;
        horizontal-alignment: root.text-alignment;
        vertical-alignment: center;
        accessible-role: none;
    }
    pointer := TouchArea { enabled: root.enabled; clicked => { keys.focus(); root.clicked(); } }
}

export component ActionButton inherits TextButton {
    in property <bool> primary;
    text-alignment: center;
    background: root.primary && root.enabled ? Theme.accent : root.hovered && root.enabled ? Theme.raised : Theme.surface;
    foreground: root.primary && root.enabled ? Theme.on-accent : Theme.text;
    border-width: root.has-focus ? 2px : 1px;
    border-color: root.has-focus || (root.primary && root.enabled) ? Theme.accent : Theme.border;
    opacity: root.pressed ? 0.8 : 1;
}
export component PrimaryButton inherits ActionButton { primary: true; }

export component Label inherits Text { vertical-stretch: 0; min-width: 0px; vertical-alignment: center; color: Theme.text; accessible-role: text; accessible-label: self.text; }
export component Chip inherits TextButton {
    in property <bool> selected;
    accessible-checkable: true;
    accessible-checked: root.selected;
    background: root.selected ? Theme.accent-soft : Theme.surface;
    foreground: root.selected ? Theme.accent : Theme.text;
    border-width: root.has-focus ? 2px : 1px;
    border-color: root.selected || root.has-focus ? Theme.accent : Theme.border;
}
export component ToneDot inherits Rectangle {
    in property <color> tone;
    width: 8px; height: 8px; border-radius: Theme.radius-control;
    background: root.tone;
    accessible-role: none;
}

export component AttachmentChip inherits Rectangle {
    in property <string> text;
    min-width: 0px; preferred-width: min(180px,caption.preferred-width + 12px); max-width: 180px; horizontal-stretch: 0;
    preferred-height: 22px; min-height: 22px; max-height: 22px; vertical-stretch: 0;
    background: Theme.raised; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-control;
    caption := Label { x: 6px; width: max(0px,parent.width - 12px); height: parent.height; text: root.text; font-size: Theme.small; overflow: elide; }
}
