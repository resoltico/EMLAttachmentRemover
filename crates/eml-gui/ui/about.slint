import { AboutSlint, TextEdit, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";
import { ActionButton, TextButton, UiMetrics } from "controls.slint";
component AboutLabel inherits TextInput {
    read-only: true; single-line: true; horizontal-alignment: center;
    accessible-label: self.text; vertical-stretch: 0;
}
export component AboutWindow inherits Window {
    in property <string> product-name;
    in property <string> version;
    in property <string> copyright;
    in property <string> notice;
    in property <string> notice-details;
    private property <bool> show-notice-details: false;
    title: "About " + root.product-name;
    icon: @image-url("eml-icon.png");
    in property <length> ui-size: 14px;
    default-font-size: root.ui-size;
    preferred-width: max(440px, root.ui-size * 30);
    preferred-height: max(490px, root.ui-size * 32) + (root.notice != "" ? 64px : 0px) + (root.show-notice-details ? 100px : 0px);
    callback website(); callback licenses(); callback dismiss();
    callback focus-website();
    focus-website => { website.focus(); }
    MenuBar {
        Menu { title: "File";
            MenuItem { title: "Close Window"; shortcut: @keys(Control + W); activated => { root.dismiss(); } }
        }
        Menu { title: "Edit";
        MenuItem { title: "Copy"; shortcut: @keys(Control + C);
            enabled: name-text.has-focus || version-text.has-focus || purpose-text.has-focus || copyright-text.has-focus;
            activated => { if name-text.has-focus { name-text.copy(); } if version-text.has-focus { version-text.copy(); } if purpose-text.has-focus { purpose-text.copy(); } if copyright-text.has-focus { copyright-text.copy(); } }
        }
        MenuItem { title: "Select All"; shortcut: @keys(Control + A);
            enabled: name-text.has-focus || version-text.has-focus || purpose-text.has-focus || copyright-text.has-focus;
            activated => { if name-text.has-focus { name-text.select-all(); } if version-text.has-focus { version-text.select-all(); } if purpose-text.has-focus { purpose-text.select-all(); } if copyright-text.has-focus { copyright-text.select-all(); } }
        }
    } }
    forward-focus: about-focus;
    about-focus := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { root.dismiss(); return accept; } return reject; }
        VerticalBox { padding: UiMetrics.gutter; spacing: UiMetrics.gap; alignment: center;
            HorizontalBox { alignment: center; padding: 0px;
                Image { source: root.icon; width: 64px; height: 64px; image-fit: contain; accessible-label: "Application icon"; }
            }
            name-text := AboutLabel { text: root.product-name; font-size: root.ui-size * 1.4; font-weight: 600; }
            version-text := AboutLabel { text: "Version " + root.version; }
            purpose-text := AboutLabel { text: "Create body-only copies of EML messages.\nKeep original messages unchanged."; single-line: false; }
            copyright-text := AboutLabel { text: root.copyright; }
            HorizontalBox { alignment: center; spacing: UiMetrics.gap; padding: 0px;
                website := ActionButton { text: "Project website"; clicked => { root.website(); } }
                ActionButton { text: "Licenses"; clicked => { root.licenses(); } }
            }
            if root.notice != "": Text { text: root.notice; wrap: word-wrap; vertical-alignment: center; color: Palette.foreground; accessible-live-region: polite; }
            if root.notice-details != "": TextButton { text: root.show-notice-details ? "Hide details" : "Details…"; expandable: true; expanded: root.show-notice-details; clicked => { root.show-notice-details = !root.show-notice-details; } }
            if root.show-notice-details && root.notice-details != "": TextEdit { text: root.notice-details; read-only: true; preferred-height: 100px; max-height: 100px; accessible-label: "Website opening details"; }
            HorizontalBox { alignment: center; vertical-stretch: 0; padding: 0px;
                AboutSlint { width: 280px; height: 100px; horizontal-stretch: 0; vertical-stretch: 0; }
            }
        }
    }
}
export component LicenseWindow inherits Window {
    title: "Software and artwork licenses";
    icon: @image-url("eml-icon.png");
    preferred-width: 720px; preferred-height: 560px;
    in property <length> ui-size: 14px;
    in property <string> licenses;
    in property <string> notice: "Third-party terms and source references are included with the application.";
    in property <string> notice-details;
    private property <bool> show-notice-details: false;
    default-font-size: root.ui-size;
    callback third-party(); callback dismiss();
    callback focus-start();
    focus-start => {
        license-text.focus();
        license-text.set-selection-offsets(0, 0);
        license-text.content-y = 0px;
    }
    MenuBar {
        Menu { title: "File";
            MenuItem { title: "Close Window"; shortcut: @keys(Control + W); activated => { root.dismiss(); } }
        }
        Menu { title: "Edit";
        MenuItem { title: "Copy"; shortcut: @keys(Control + C); enabled: license-text.has-focus; activated => { license-text.copy(); } }
        MenuItem { title: "Select All"; shortcut: @keys(Control + A); enabled: license-text.has-focus; activated => { license-text.select-all(); } }
    } }
    forward-focus: license-focus;
    license-focus := FocusScope {
        forward-focus: license-text;
        key-pressed(event) => { if event.text == Key.Escape { root.dismiss(); return accept; } return reject; }
        VerticalBox { padding: UiMetrics.gutter; spacing: UiMetrics.inset;
            license-text := TextEdit { text: root.licenses; read-only: true; accessible-label: "Software and artwork license terms"; }
            VerticalBox { padding: 0px; spacing: UiMetrics.gap; vertical-stretch: 0;
                Text { text: root.notice; wrap: word-wrap; vertical-alignment: center; color: Palette.foreground; accessible-live-region: polite; }
                if root.notice-details != "": TextButton { text: root.show-notice-details ? "Hide details" : "Details…"; expandable: true; expanded: root.show-notice-details; clicked => { root.show-notice-details = !root.show-notice-details; } }
                if root.show-notice-details && root.notice-details != "": TextEdit { text: root.notice-details; read-only: true; preferred-height: 100px; max-height: 100px; accessible-label: "Notices opening details"; }
                HorizontalBox { padding: 0px; alignment: end;
                    ActionButton { text: "Third-party licenses…"; clicked => { root.third-party(); } }
                }
            }
        }
    }
}
