import { Tone } from "models.slint";
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <color> clear: transparent;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> surface: dark ? #1e1e21 : #ffffff;
    out property <color> raised: dark ? #2c2c30 : #f6f6f7;
    out property <color> border: dark ? #505058 : #c0c0c8;
    out property <color> text: dark ? #f2f2f4 : #202024;
    out property <color> muted: dark ? #b0b0b8 : #60606a;
    out property <color> accent: dark ? #90b8ff : #155ac9;
    out property <color> on-accent: dark ? #202024 : #ffffff;
    out property <color> accent-soft: dark ? #1f3355 : #e5efff;
    out property <color> ok: dark ? #65d8a0 : #147345;
    out property <color> warn: dark ? #f0c065 : #805200;
    out property <color> bad: dark ? #ff9890 : #b42318;
    out property <length> title: 22px;
    out property <length> body: 13px;
    out property <length> small: 12px;
    out property <length> caption: 11.5px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> radius-control: 6px;
    out property <length> radius-container: 10px;
    out property <length> control-height: 32px;
    out property <length> row-height: 44px;
    out property <length> footer-height: 60px;
    out property <length> line-height: 18px;
    out property <length> column-max-width: 980px;
    public pure function tone(t: Tone) -> color {
        return t == Tone.accent ? root.accent : t == Tone.ok ? root.ok : t == Tone.warn ? root.warn : t == Tone.bad ? root.bad : root.muted;
    }
}
