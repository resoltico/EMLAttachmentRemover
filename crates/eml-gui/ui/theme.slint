import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> sidebar: dark ? #26262a : #ececee;
    out property <color> surface: dark ? #1e1e21 : #ffffff;
    out property <color> raised: dark ? #2c2c30 : #f6f6f7;
    out property <color> border: dark ? #505058 : #c0c0c8;
    out property <color> text: dark ? #f2f2f4 : #202024;
    out property <color> muted: dark ? #b0b0b8 : #60606a;
    out property <color> accent: dark ? #90b8ff : #155ac9;
    out property <color> accent-soft: dark ? #1f3355 : #e5efff;
    out property <color> ok: dark ? #65d8a0 : #147345;
    out property <color> warn: dark ? #f0c065 : #805200;
    out property <color> bad: dark ? #ff9890 : #b42318;
    out property <color> idle: dark ? #b0b0b8 : #62626a;
    out property <length> pad: 20px;
    out property <length> gap: 8px;
    out property <length> radius: 8px;
}
