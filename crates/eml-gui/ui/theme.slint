import { Tone } from "models.slint";
import { WidgetMetrics } from "widget-metrics.slint";
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <length> tooltip-max-width: 480px;
    out property <length> footer-notice-height: self.line-height * 2 + self.space-2;
    out property <length> scroll-inset: WidgetMetrics.scroll-inset;
    out property <float> email-fraction: 0.32;
    out property <float> detail-fraction: 0.3;
    out property <length> size-column: 145px;
    out property <length> status-column: 175px;
    out property <length> wide-breakpoint: 900px;
    out property <length> column-header-height: 28px;
    out property <length> part-size-column: 75px;
    out property <length> name-line: 18px;
    out property <length> folder-line: 17px;
    out property <length> chip-line: 22px;
    out property <length> path-line: 18px;
    out property <length> detail-cap: 200px;
    out property <length> dot-box: 8px;
    out property <length> drop-outline: 2px;
    out property <length> focus-border: 2px;
    out property <length> attachment-chip-width: 180px;
    out property <length> attachment-chip-padding: 6px;
    out property <length> window-min-width: 760px;
    out property <length> window-min-height: 520px;
    out property <length> window-width: 1080px;
    out property <length> window-height: 700px;
    out property <length> destination-popup-width: 340px;
    out property <length> destination-popup-base-height: 88px;
    out property <length> popup-row-height: 36px;
    out property <length> output-popup-width: 420px;
    out property <length> output-popup-cap: 400px;
    out property <length> quit-dialog-y: 70px;
    out property <length> quit-dialog-width: 480px;
    out property <length> about-width: 440px;
    out property <length> about-height: 490px;
    out property <length> about-notice-height: 64px;
    out property <length> about-icon-size: 64px;
    out property <length> slint-notice-width: 280px;
    out property <length> slint-notice-height: 100px;
    out property <length> license-width: 720px;
    out property <length> license-height: 560px;
    out property <length> empty-width: 560px;
    out property <length> empty-padding: 32px;

    out property <length> diagnostic-height: 100px;
    out property <color> clear: transparent;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> surface: dark ? #1e1e21 : #ffffff;
    out property <color> raised: dark ? #2c2c30 : #f6f6f7;
    out property <color> border: dark ? #505058 : #c0c0c8;
    out property <color> text: dark ? #f2f2f4 : #202024;
    out property <color> muted: dark ? #b0b0b8 : #60606a;
    out property <color> accent: dark ? #90b8ff : #155ac9;
    out property <color> on-accent: dark ? #202024 : #ffffff;
    out property <color> accent-soft: dark ? #1f3355 : #e5efff;
    out property <color> ok: dark ? #65d8a0 : #147345;
    out property <color> warn: dark ? #f0c065 : #805200;
    out property <color> bad: dark ? #ff9890 : #b42318;
    out property <length> title: 22px;
    out property <length> body: 13px;
    out property <length> small: 12px;
    out property <length> caption: 11.5px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> radius-control: 6px;
    out property <length> radius-container: 10px;
    out property <length> control-height: 32px;
    out property <length> row-height: 44px;
    out property <length> footer-height: 60px;
    out property <length> line-height: 18px;
    out property <length> column-max-width: 980px;
    public pure function tone(t: Tone) -> color {
        return t == Tone.accent ? root.accent : t == Tone.ok ? root.ok : t == Tone.warn ? root.warn : t == Tone.bad ? root.bad : root.muted;
    }
}
