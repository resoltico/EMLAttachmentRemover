// Supplied SVG geometry is embedded unchanged; native appearance selects its palette.
export component StatusArtwork inherits Image {
    in property <int> state;
    in property <bool> dark;
    in property <bool> contrast;
    width: 48px; height: 48px; image-fit: contain;
    accessible-label: root.state == 0 ? "EML Attachment Remover" : root.state == 1 ? "Processing" : root.state == 2 ? "Completed" : root.state == 3 ? "Stopped" : "Needs attention";
    property <image> light: root.state == 0 ? @image-url("../../../artwork/artwork-svg/regular/light/identity.svg") : root.state == 1 ? @image-url("../../../artwork/artwork-svg/regular/light/processing.svg") : root.state == 2 ? @image-url("../../../artwork/artwork-svg/regular/light/success.svg") : root.state == 3 ? @image-url("../../../artwork/artwork-svg/regular/light/stopped.svg") : root.state == 4 ? @image-url("../../../artwork/artwork-svg/regular/light/attention.svg") : root.state == 5 ? @image-url("../../../artwork/artwork-svg/regular/light/attention-failure.svg") : @image-url("../../../artwork/artwork-svg/regular/light/identity.svg");
    property <image> dark_palette: root.state == 0 ? @image-url("../../../artwork/artwork-svg/regular/dark/identity.svg") : root.state == 1 ? @image-url("../../../artwork/artwork-svg/regular/dark/processing.svg") : root.state == 2 ? @image-url("../../../artwork/artwork-svg/regular/dark/success.svg") : root.state == 3 ? @image-url("../../../artwork/artwork-svg/regular/dark/stopped.svg") : root.state == 4 ? @image-url("../../../artwork/artwork-svg/regular/dark/attention.svg") : root.state == 5 ? @image-url("../../../artwork/artwork-svg/regular/dark/attention-failure.svg") : @image-url("../../../artwork/artwork-svg/regular/dark/identity.svg");
    property <image> hc_light: root.state == 0 ? @image-url("../../../artwork/artwork-svg/regular/hc-light/identity.svg") : root.state == 1 ? @image-url("../../../artwork/artwork-svg/regular/hc-light/processing.svg") : root.state == 2 ? @image-url("../../../artwork/artwork-svg/regular/hc-light/success.svg") : root.state == 3 ? @image-url("../../../artwork/artwork-svg/regular/hc-light/stopped.svg") : root.state == 4 ? @image-url("../../../artwork/artwork-svg/regular/hc-light/attention.svg") : root.state == 5 ? @image-url("../../../artwork/artwork-svg/regular/hc-light/attention-failure.svg") : @image-url("../../../artwork/artwork-svg/regular/hc-light/identity.svg");
    property <image> hc_dark: root.state == 0 ? @image-url("../../../artwork/artwork-svg/regular/hc-dark/identity.svg") : root.state == 1 ? @image-url("../../../artwork/artwork-svg/regular/hc-dark/processing.svg") : root.state == 2 ? @image-url("../../../artwork/artwork-svg/regular/hc-dark/success.svg") : root.state == 3 ? @image-url("../../../artwork/artwork-svg/regular/hc-dark/stopped.svg") : root.state == 4 ? @image-url("../../../artwork/artwork-svg/regular/hc-dark/attention.svg") : root.state == 5 ? @image-url("../../../artwork/artwork-svg/regular/hc-dark/attention-failure.svg") : @image-url("../../../artwork/artwork-svg/regular/hc-dark/identity.svg");
    source: root.contrast ? (root.dark ? root.hc_dark : root.hc_light) : (root.dark ? root.dark_palette : root.light);
}
