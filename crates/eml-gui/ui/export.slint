import { LineEdit, ScrollView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";
import { ActionButton, UiMetrics } from "controls.slint";
export component ExportWindow inherits Window {
    title: "Export new report";
    icon: @image-url("eml-icon.png");
    in property <length> ui-size: 14px;
    default-font-size: root.ui-size;
    preferred-width: max(560px, root.ui-size * 32);
    preferred-height: max(320px, root.ui-size * 23);
    min-width: max(480px, root.ui-size * 28); min-height: max(300px, root.ui-size * 21);
    in property <string> run-label;
    in property <string> directory;
    in-out property <string> file-name;
    in property <string> notice;
    in property <bool> busy;
    callback choose-directory(); callback create-report(); callback cancel();
    MenuBar { Menu { title: "Edit";
        MenuItem { title: "Copy"; shortcut: @keys(Control + C); enabled: name.has-focus || feedback.has-focus; activated => { if name.has-focus { name.copy(); } else { feedback.copy(); } } }
        MenuItem { title: "Paste"; shortcut: @keys(Control + V); enabled: !root.busy && name.has-focus; activated => { name.paste(); } }
        MenuItem { title: "Select All"; shortcut: @keys(Control + A); enabled: name.has-focus || feedback.has-focus; activated => { if name.has-focus { name.select-all(); } else { feedback.select-all(); } } }
    } }
    forward-focus: export-focus;
    export-focus := FocusScope {
        forward-focus: name;
        key-pressed(event) => { if event.text == Key.Escape && !root.busy { root.cancel(); return accept; } return reject; }
        VerticalBox { padding: UiMetrics.gutter; spacing: UiMetrics.gap; alignment: start;
            Text { text: "Save report for " + root.run-label; font-size: root.ui-size * 1.4; font-weight: 600; color: Palette.foreground; }
            Text { text: "Save the exact diagnostic JSONL. Existing files are never replaced."; wrap: word-wrap; color: Palette.foreground; }
            HorizontalBox { padding: 0px; spacing: UiMetrics.gap;
                Text { text: root.directory; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; color: Palette.foreground; accessible-label: "Report folder: " + root.directory; Tooltip { text: @markdown("\{root.directory}"); } }
                ActionButton { text: "Choose folder…"; enabled: !root.busy; accessible-description: "Choose the report export folder."; clicked => { root.choose-directory(); } }
            }
            Text { text: "File name"; color: Palette.foreground; }
            name := LineEdit { text <=> root.file-name; enabled: !root.busy; accessible-label: "File name"; accessible-description: "Name of the new diagnostic JSONL report."; accepted => { if !root.busy { root.create-report(); } } }
            ScrollView { preferred-height: min(88px, feedback.preferred-height); min-height: min(44px, feedback.preferred-height); vertical-stretch: 0;
                content-width: self.visible-width; content-height: feedback.preferred-height;
                feedback := TextInput { text: root.notice; read-only: true; wrap: word-wrap; color: Palette.foreground;
                    width: parent.visible-width; height: self.preferred-height;
                    accessible-label: "Report export feedback"; accessible-live-region: polite;
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalBox { padding: 0px; alignment: end; spacing: UiMetrics.gap;
                ActionButton { text: "Cancel"; enabled: !root.busy; clicked => { root.cancel(); } }
                ActionButton { text: root.busy ? "Saving…" : "Save report"; enabled: !root.busy; primary: true; accessible-description: "Save the exact captured diagnostic JSONL."; clicked => { root.create-report(); } }
            }
        }
    }
}
