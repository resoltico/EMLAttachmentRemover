import { TextEdit, HorizontalBox, VerticalBox, ListView, ScrollView, ProgressIndicator, Palette, RadioGroup, CheckBox } from "std-widgets.slint";
import { ActionButton, TextButton, UiMetrics } from "controls.slint";
export enum Confirmation { none, force-stop, quit }
export struct CountView { label: string, value: int, accessible: string, attention: bool }
export struct PathView { prefix: string, suffix: string, directory: string, full: string }
export struct RunView { label: string, status: string, mode: string, destination: string, selection: PathView, selections: CountView }
export struct ItemView { original-index: int, source: string, destination: string, status: string, removed: string, attention: bool, path: PathView }
export struct DetailView { text: string }
export struct RemovalView { section: string, filename: string, media: string, bytes: int, byte-label: string, byte-accessible: string, reason: string }
component Label inherits Text { vertical-stretch: 0; min-width: 0px; vertical-alignment: center; color: Palette.foreground; accessible-role: text; accessible-label: self.text; }
// Text measures its own glyphs; the suffix stays visible as the prefix elides.
component FileName inherits Rectangle {
    in property <PathView> path;
    in property <length> text-size: 14px;
    height: max(22px, root.text-size * 1.4);
    horizontal-stretch: 1;
    min-width: 0px;
    accessible-role: text;
    accessible-label: root.path.full;
    prefix := Text {
        x: 0px;
        horizontal-alignment: left;
        color: Palette.foreground;
        font-size: root.text-size;
        text: root.path.prefix;
        width: min(self.preferred-width, max(0px, root.width - suffix.width));
        height: parent.height;
        overflow: elide;
        vertical-alignment: center;
    }
    suffix := Text {
        color: Palette.foreground;
        font-size: root.text-size;
        text: root.path.suffix;
        x: prefix.width;
        width: min(self.preferred-width, root.path.prefix == "" ? root.width : root.width * 0.6);
        height: parent.height;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: clip;
    }
    Tooltip { text: @markdown("\{root.path.full}"); }
}
component PathLabel inherits VerticalBox {
    in property <PathView> path;
    in property <length> text-size: 14px;
    padding: 0px; spacing: 0px;
    FileName { path: root.path; text-size: root.text-size; }
    Label { text: root.path.directory; font-size: max(12px, root.text-size * 0.9); opacity: 0.72; overflow: elide; min-width: 0px; Tooltip { text: @markdown("\{root.path.full}"); } }
}
export { AboutWindow, LicenseWindow } from "about.slint";
export { ExportWindow } from "export.slint";
export component MainWindow inherits Window {
    in property <string> product-name;
    title: root.product-name;
    icon: @image-url("eml-icon.png");
    background: Palette.background;
    in property <length> ui-size: 14px;
    default-font-size: root.ui-size;
    preferred-width: 960px; preferred-height: 680px;
    min-width: 780px; min-height: 600px;
    in property <bool> native-about;
    in property <bool> closing;
    in-out property <bool> check-only;
    in property <string> destination-label;
    in property <[PathView]> selection;
    in property <bool> reviewing;
    in property <bool> can-start;
    in property <string> start-label;
    in property <string> start-reason;
    in property <bool> has-reports;
    in property <bool> worker-running;
    in property <string> activity-label;
    in property <string> run-label;
    in property <string> run-status;
    in property <string> run-context;
    in property <string> queue-notice;
    in-out property <length> details-scroll-y: 0px;
    in property <[RunView]> runs;
    in property <[RunView]> waiting;
    in property <[ItemView]> items;
    in property <[CountView]> counts;
    in property <[DetailView]> report-diagnostics;
    in property <string> settings-warning;
    in property <bool> can-copy-source;
    in property <bool> can-copy-destination;
    callback copy-source-path(); callback copy-destination-path();
    in property <string> operation-label;
    in property <string> operation-feedback;
    in property <PathView> item-source-path;
    in property <PathView> item-destination-path;
    in property <[DetailView]> details;
    in property <[CountView]> byte-counts;
    in property <[RemovalView]> removals;
    in property <[DetailView]> stripped;
    in property <string> removal-heading;
    in property <string> field-heading;
    in property <string> item-source;
    in property <string> item-destination;
    in property <string> item-status;
    in property <bool> has-item;
    in property <bool> item-attention;
    in property <bool> run-attention;
    private property <brush> attention-color: UiMetrics.attention;
    in property <int> selected-item;
    in property <int> selected-visible-row: -1;
    in-out property <bool> attention-only;
    in-out property <bool> keyboard-navigation;
    in property <bool> destination-beside;
    private property <length> message-row-height: max(56px, root.ui-size * 3.7);
    callback filter-attention(bool); callback navigate-message(int);
    in-out property <length> messages-scroll-y;
    out property <length> messages-view-height;
    function reveal-selected() {
        if root.messages-view-height > 0px {
            // Selection and viewport can arrive on different layout updates.
            if root.selected-visible-row >= 0 && root.selected-visible-row < root.items.length {
                if root.messages-scroll-y + root.selected-visible-row * root.message-row-height < 0px {
                    root.messages-scroll-y = -root.selected-visible-row * root.message-row-height;
                } else if root.messages-scroll-y + (root.selected-visible-row + 1) * root.message-row-height > root.messages-view-height {
                    root.messages-scroll-y = max(-root.selected-visible-row * root.message-row-height,
                        root.messages-view-height - (root.selected-visible-row + 1) * root.message-row-height);
                }
            }
            // Revealing a row must never scroll past the current content extent.
            root.messages-scroll-y = max(min(0px, root.messages-view-height - root.items.length * root.message-row-height),
                min(0px, root.messages-scroll-y));
        }
    }
    // MainWindow survives the task drawer that this transition closes.
    function show-storage-confirmation() {
        tasks.close();
        storage-confirm.show();
    }
    changed selected-visible-row => { root.reveal-selected(); }
    changed messages-view-height => { root.reveal-selected(); }
    changed message-row-height => { root.reveal-selected(); }
    changed keyboard-navigation => { if root.keyboard-navigation { root.reveal-selected(); } }

    in property <int> selected-run;
    in property <int> work-total;
    in property <int> work-completed;
    in-out property <bool> details-expanded: false;
    in property <bool> report-running;
    in property <bool> can-export;
    in property <bool> can-create;
    in property <bool> can-reveal;
    in property <bool> can-dismiss;
    in-out property <Confirmation> confirmation;
    in property <string> force-notice;
    callback choose-files(); callback choose-folder(); callback choose-destination(); callback beside-source();
    callback start-selection(); callback clear-selection(); callback review-selection(); callback remove-selection(int);
    callback mode-changed(bool); callback select-run(int); callback select-item(int); callback remove-waiting(int);
    callback stop(); callback force-stop(); callback export-report(); callback reveal(); callback review-request(); callback dismiss();
    callback confirm-force-stop();
    callback about(); callback cancel-confirmation(); callback stop-and-quit(); callback force-and-quit();
    // Distinct task lifetimes and action targets are supplied by the controller.
    in property <string> review-label;
    in property <bool> can-review;
    in property <bool> stop-requested;
    in property <bool> export-running;
    in property <bool> report-loading;
    in property <string> report-load-notice;
    in property <bool> can-reveal-report;
    in property <bool> native-open-pending;
    in property <bool> report-storage-enabled;
    in property <bool> storage-retry;
    in property <string> operation-details;
    in property <string> report-details;
    in property <PathView> saved-report-path;
    callback new-request(); callback reveal-report(); callback allow-report-storage();
    callback retry-report-storage();
    private property <bool> operation-details-expanded: false;
    private property <bool> report-details-expanded: false;
    changed selected-run => { root.report-details-expanded = false; }
    private property <length> outcome-width: max(160px, min(220px, root.ui-size * 12));
    private property <string> selected-removals: root.selected-visible-row >= 0 && root.selected-visible-row < root.items.length ? root.items[root.selected-visible-row].removed : "";
    MenuBar {
        Menu { title: "File";
            MenuItem { title: "New request"; shortcut: @keys(Control + N); enabled: !root.closing && root.confirmation == Confirmation.none; activated => { root.new-request(); } }
            MenuItem { title: "Open files…"; shortcut: @keys(Control + O); enabled: !root.closing && root.confirmation == Confirmation.none; activated => { root.choose-files(); } }
            MenuItem { title: "Add folder…"; enabled: !root.closing && root.confirmation == Confirmation.none; activated => { root.choose-folder(); } }
        }
        if !root.native-about: Menu { title: "Help";
            MenuItem { title: "About"; activated => { root.about(); } }
        }
    }
    VerticalBox { padding: 0px; spacing: 0px;
        header := HorizontalBox { padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: 12px; padding-bottom: 12px; spacing: UiMetrics.gap; vertical-stretch: 0;
            ActionButton { text: "Tasks" + (root.waiting.length > 0 ? " · " + root.waiting.length + " waiting" : ""); accessible-label: "Tasks"; clicked => { tasks.show(); } }
            Rectangle { horizontal-stretch: 1; }
            ActionButton { text: "New request"; enabled: !root.closing; accessible-label: self.text; clicked => { root.new-request(); } }
        }
        Rectangle { height: 1px; background: Palette.border; opacity: 0.35; }
        if root.worker-running || root.export-running: HorizontalBox {
            padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: UiMetrics.gap; padding-bottom: UiMetrics.gap; spacing: UiMetrics.gap; vertical-stretch: 0;
            Label { text: root.activity-label; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; accessible-label: "Active task: " + root.activity-label; }
            if root.worker-running: TextButton { text: "Force stop…"; danger: true; enabled: !root.closing; accessible-label: "Force Stop"; clicked => { root.force-stop(); } }
            if root.worker-running: ActionButton { text: root.stop-requested ? "Stopping…" : "Stop"; enabled: !root.stop-requested && !root.closing; accessible-label: "Stop"; clicked => { root.stop(); } }
        }
        if root.settings-warning != "": HorizontalBox {
            padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: UiMetrics.label-gap; padding-bottom: UiMetrics.label-gap; spacing: UiMetrics.gap; vertical-stretch: 0;
            Label { text: "Settings unavailable — destination changes won't be saved"; wrap: word-wrap; color: root.attention-color; horizontal-stretch: 1; }
            TextButton { text: "Details…"; accessible-label: "Settings warning details"; clicked => { settings-popup.show(); } }
        }
        if root.operation-feedback != "": VerticalBox {
            padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: UiMetrics.label-gap; padding-bottom: UiMetrics.label-gap; spacing: UiMetrics.label-gap; vertical-stretch: 0;
            HorizontalBox { padding: 0px; spacing: UiMetrics.gap;
                Label { text: root.operation-label + ": " + root.operation-feedback; wrap: word-wrap; horizontal-stretch: 1; accessible-live-region: polite; }
                if root.operation-details != "": TextButton { text: root.operation-details-expanded ? "Hide details" : "Details…"; expandable: true; expanded: root.operation-details-expanded; clicked => { root.operation-details-expanded = !root.operation-details-expanded; } }
            }
            if root.operation-details-expanded && root.operation-details != "": TextEdit { text: root.operation-details; read-only: true; preferred-height: 72px; max-height: 72px; accessible-label: "Operation technical details"; }
        }
        workspace := VerticalBox { padding: UiMetrics.gutter; spacing: UiMetrics.gap;
            if root.reviewing || !root.has-reports: VerticalBox { padding: 0px; spacing: UiMetrics.inset;
                HorizontalBox { padding: 0px; spacing: UiMetrics.gap; vertical-stretch: 0;
                    VerticalBox { padding: 0px; spacing: UiMetrics.label-gap; horizontal-stretch: 1;
                        Label { text: root.selection.length == 0 ? "Choose messages to begin" : "Review request"; font-size: root.ui-size * 1.4; font-weight: 600; }
                        Label { text: root.selection.length == 0 ? "Drop .eml files or a folder here, or choose them below." : root.selection.length + (root.selection.length == 1 ? " selection · folders are scanned when started" : " selections · folders are scanned when started"); wrap: word-wrap; opacity: 0.75; }
                    }
                    ActionButton { text: "Add files…"; enabled: !root.closing; accessible-label: self.text; clicked => { root.choose-files(); } }
                    ActionButton { text: "Add folder…"; enabled: !root.closing; accessible-label: self.text; clicked => { root.choose-folder(); } }
                }
                RadioGroup { title: "Operation"; orientation: horizontal; enabled: !root.closing;
                    selected(value) => { if (value == "Check only") != root.check-only { root.mode-changed(value == "Check only"); } }
                    RadioButton { text: "Create copies"; checked: !root.check-only; }
                    RadioButton { text: "Check only"; checked: root.check-only; }
                }
                HorizontalBox { padding: 0px; spacing: UiMetrics.gap; vertical-stretch: 0;
                    VerticalBox { padding: 0px; spacing: UiMetrics.label-gap; horizontal-stretch: 1;
                        Label { text: root.check-only ? "Check destination" : "Save copies"; font-weight: 600; }
                        Label { text: root.destination-label; overflow: elide; Tooltip { text: @markdown("\{root.destination-label}"); } }
                    }
                    ActionButton { text: "Change…"; enabled: !root.closing; accessible-label: "Change destination"; clicked => { destination-menu.show(); } }
                }
                ListView { content-width: self.visible-width; accessible-role: list; accessible-label: "Selection ready to start";
                    preferred-height: min(240px, root.selection.length * root.message-row-height); min-height: 0px; vertical-stretch: 1;
                    for path[index] in root.selection: Rectangle { height: root.message-row-height;
                        HorizontalBox { width: parent.width; height: parent.height; padding: UiMetrics.gap; padding-left: 12px; padding-right: 12px; spacing: UiMetrics.gap;
                            PathLabel { path: path; text-size: root.ui-size; }
                            TextButton { text: "Remove"; enabled: !root.closing; accessible-label: "Remove selection " + path.full; clicked => { root.remove-selection(index); } }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; opacity: 0.35; }
                    }
                }
                if !root.report-storage-enabled: HorizontalBox { padding: 0px; spacing: UiMetrics.gap; vertical-stretch: 0;
                    Label { text: "Let queued work continue without closing results by keeping session reports in private temporary storage."; wrap: word-wrap; opacity: 0.75; horizontal-stretch: 1; }
                    TextButton { text: "Allow temporary storage…"; enabled: !root.closing; clicked => { root.show-storage-confirmation(); } }
                }
                if root.report-storage-enabled: HorizontalBox { padding: 0px; spacing: UiMetrics.gap; vertical-stretch: 0;
                    Label { text: "Private temporary report storage is enabled for this session."; font-size: max(12px, root.ui-size * 0.86); opacity: 0.75; horizontal-stretch: 1; }
                    TextButton { text: "Storage details"; clicked => { storage-info.show(); } }
                }
                if root.selection.length > 0 && !root.can-start: Label { text: root.start-reason; wrap: word-wrap; color: root.attention-color; }
                HorizontalBox { padding: 0px; spacing: UiMetrics.gap; vertical-stretch: 0;
                    Label { text: root.check-only ? "No copies will be written." : "Copies use name.no-attachments.eml."; wrap: word-wrap; opacity: 0.75; horizontal-stretch: 1; vertical-alignment: center; }
                    if root.selection.length > 0: TextButton { text: "Clear selection"; enabled: !root.closing; accessible-label: self.text; clicked => { root.clear-selection(); } }
                    ActionButton { text: root.start-label; enabled: root.can-start; primary: true; accessible-label: "Start selection"; accessible-description: root.start-reason; clicked => { root.start-selection(); } }
                }
            }
            if root.has-reports && !root.reviewing: VerticalBox { padding: 0px; spacing: UiMetrics.gap; alignment: start;
                VerticalBox { padding: 0px; spacing: UiMetrics.label-gap; vertical-stretch: 0;
                    Label { text: root.run-label + " · " + root.run-status; font-size: root.ui-size * 1.4; font-weight: 600; wrap: word-wrap; accessible-live-region: polite; }
                    Label { text: root.run-context; overflow: elide; opacity: 0.75; Tooltip { text: @markdown("\{root.run-context}"); } }
                }
                HorizontalBox { padding: 0px; spacing: UiMetrics.gap; vertical-stretch: 0;
                    ActionButton { text: "Save report…"; enabled: root.can-export && !root.closing; accessible-label: "Save JSONL report"; clicked => { root.export-report(); } }
                    if root.can-review: ActionButton { text: root.review-label; enabled: root.selection.length == 0 && !root.closing; primary: root.can-create; accessible-label: "Review these inputs again"; accessible-description: root.selection.length > 0 ? "Finish or clear the current reviewed selection first." : "Review the original selected roots and current settings before starting another request."; clicked => { root.review-request(); } }
                    TextButton { text: "Close result"; enabled: root.can-dismiss; accessible-label: "Dismiss report"; clicked => { root.dismiss(); } }
                }
                if root.saved-report-path.full != "": HorizontalBox { padding: 0px; spacing: UiMetrics.gap; vertical-stretch: 0;
                    Label { text: "Saved report"; horizontal-stretch: 0; }
                    PathLabel { path: root.saved-report-path; text-size: root.ui-size; }
                    TextButton { text: "Show report"; enabled: root.can-reveal-report && !root.native-open-pending && !root.closing; accessible-label: "Show saved report"; clicked => { root.reveal-report(); } }
                }
                if root.report-loading: Label { text: root.report-load-notice; wrap: word-wrap; accessible-live-region: polite; }
                if !root.report-loading: HorizontalBox { padding: 0px; spacing: UiMetrics.inset; vertical-stretch: 0;
                    for count in root.counts: Label { text: count.label + ": " + count.value; color: count.attention ? root.attention-color : Palette.foreground; accessible-label: count.accessible; wrap: word-wrap; min-width: 0px; }
                }
                if !root.report-loading && root.report-diagnostics.length > 0: ScrollView {
                    preferred-height: min(96px, diagnostics.preferred-height); min-height: 0px; vertical-stretch: 0;
                    content-width: self.visible-width; content-height: diagnostics.preferred-height;
                    accessible-role: list; accessible-label: "Run diagnostics";
                    diagnostics := VerticalBox { width: parent.visible-width; height: self.preferred-height; padding: 0px; spacing: UiMetrics.label-gap;
                        for row in root.report-diagnostics: Label { text: row.text; wrap: word-wrap; }
                    }
                }
                if !root.report-loading && root.report-details != "": TextButton {
                    text: root.report-details-expanded ? "Hide failure details" : "Failure details…"; expandable: true; expanded: root.report-details-expanded;
                    clicked => { root.report-details-expanded = !root.report-details-expanded; }
                }
                if !root.report-loading && root.report-details-expanded && root.report-details != "": TextEdit {
                    text: root.report-details; read-only: true; preferred-height: 96px; max-height: 96px; accessible-label: "Run failure technical details";
                }
                if root.report-running: ProgressIndicator {
                    progress: root.work-total > 0 ? (root.work-completed * 1.0) / root.work-total : 0;
                    indeterminate: root.work-total == 0;
                    accessible-label: root.work-total > 0 ? root.work-completed + " of " + root.work-total + " messages processed" : "Discovering messages";
                }
                if !root.report-loading: HorizontalBox { padding: 0px; alignment: end; vertical-stretch: 0;
                    CheckBox { text: "Needs attention only"; checked: root.attention-only; accessible-label: "Filter messages needing attention"; toggled => { root.keyboard-navigation = false; root.filter-attention(self.checked); } }
                }
                if !root.report-loading && root.items.length > 0: HorizontalBox {
                    padding: 0px; padding-left: 12px; padding-right: 12px; spacing: UiMetrics.inset; vertical-stretch: 0;
                    Label { text: "Message"; font-size: max(12px, root.ui-size * 0.86); opacity: 0.75; horizontal-stretch: 1; }
                    Label { text: "Outcome"; font-size: max(12px, root.ui-size * 0.86); opacity: 0.75; width: root.outcome-width; horizontal-stretch: 0; }
                }
                if !root.report-loading && root.items.length == 0: Label { text: root.attention-only ? "No reported messages need attention." : (root.report-running ? "No message results yet." : "No message results were reported."); wrap: word-wrap; opacity: 0.75; }
                // One tab stop owns result navigation; rows expose selectable AX items.
                message-keys := FocusScope {
                    visible: !root.report-loading;
                    enabled: !root.report-loading && root.items.length > 0;
                    preferred-height: root.items.length > 0 && !root.report-loading ? min(280px, root.items.length * root.message-row-height) : 0px;
                    min-height: root.items.length > 0 && !root.report-loading ? root.message-row-height : 0px;
                    max-height: root.items.length > 0 && !root.report-loading ? root.items.length * root.message-row-height : 0px;
                    vertical-stretch: 1;
                    key-pressed(event) => {
                        if event.text == Key.DownArrow { root.keyboard-navigation = true; root.navigate-message(1); root.reveal-selected(); return accept; }
                        if event.text == Key.UpArrow { root.keyboard-navigation = true; root.navigate-message(-1); root.reveal-selected(); return accept; }
                        if event.text == Key.Home { root.keyboard-navigation = true; root.navigate-message(-2); root.reveal-selected(); return accept; }
                        if event.text == Key.End { root.keyboard-navigation = true; root.navigate-message(2); root.reveal-selected(); return accept; }
                        return reject;
                    }
                    message-list := ListView {
                        width: parent.width; height: parent.height;
                        init => { root.messages-view-height = self.height; }
                        content-y <=> root.messages-scroll-y; changed height => { root.messages-view-height = self.height; }
                        content-width: self.visible-width; accessible-role: list; accessible-label: "Message results";
                        for item[index] in root.items: Rectangle {
                            height: root.message-row-height;
                            background: item.original-index == root.selected-item ? Palette.alternate-background : transparent;
                            border-radius: 4px;
                            border-width: message-keys.has-focus && item.original-index == root.selected-item ? 1px : 0px;
                            border-color: Palette.accent-background;
                            accessible-role: list-item; accessible-label: item.path.full;
                            accessible-description: item.status + "; " + item.removed;
                            accessible-item-selectable: true; accessible-item-selected: item.original-index == root.selected-item;
                            accessible-action-default => { message-keys.focus(); root.select-item(item.original-index); }
                            TouchArea { clicked => { message-keys.focus(); root.keyboard-navigation = false; root.select-item(item.original-index); } }
                            HorizontalBox { width: parent.width; height: parent.height; padding: UiMetrics.gap; padding-left: 12px; padding-right: 12px; spacing: UiMetrics.inset;
                                PathLabel { path: item.path; text-size: root.ui-size; }
                                Label { text: item.status; color: item.attention ? root.attention-color : Palette.foreground; width: root.outcome-width; horizontal-stretch: 0; wrap: word-wrap; vertical-alignment: center; }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; opacity: 0.35; }
                        }
                    }
                }
                if !root.report-loading && root.has-item: VerticalBox { padding: 0px; spacing: UiMetrics.label-gap; vertical-stretch: 0;
                    HorizontalBox { padding: 0px; spacing: UiMetrics.gap; vertical-stretch: 0;
                        Label { text: "Selected message"; font-weight: 600; horizontal-stretch: 0; accessible-label: "Message details heading"; vertical-alignment: center; }
                        FileName { path: root.item-source-path; text-size: root.ui-size; }
                        if root.can-reveal: TextButton { text: "Show copy"; enabled: !root.native-open-pending && !root.closing; accessible-label: self.text; clicked => { root.reveal(); } }
                    }
                    details-view := ScrollView {
                        content-y <=> root.details-scroll-y; min-height: 0px; vertical-stretch: 0;
                        preferred-height: min(root.details-expanded ? 240px : 144px, detail-content.preferred-height);
                        accessible-role: list; accessible-label: "Message details";
                        content-width: self.visible-width; content-height: detail-content.preferred-height;
                        detail-content := VerticalBox { width: details-view.visible-width; height: self.preferred-height; padding: 0px; spacing: UiMetrics.label-gap;
                            if root.removals.length > 0: Label { text: root.selected-removals; color: root.item-attention ? root.attention-color : Palette.foreground; font-weight: 600; wrap: word-wrap; }
                            for detail in root.details: Label { text: detail.text; wrap: word-wrap; }
                            TextButton { text: root.details-expanded ? "▾ Hide technical details" : "▸ Technical details";
                                accessible-label: "Message technical details"; expandable: true; expanded: root.details-expanded;
                                clicked => { root.details-expanded = !root.details-expanded; }
                            }
                            if root.details-expanded: VerticalBox { padding: 0px; spacing: UiMetrics.gap;
                                Label { text: "Source"; font-weight: 600; }
                                HorizontalBox { padding: 0px; spacing: UiMetrics.gap;
                                    PathLabel { path: root.item-source-path; text-size: root.ui-size; }
                                    TextButton { text: "Copy path"; accessible-label: "Copy source path"; enabled: root.can-copy-source; accessible-description: root.can-copy-source ? "Copy the source path as text." : "This native filename cannot be represented as clipboard text. The JSONL report retains its original encoding."; clicked => { root.copy-source-path(); }
                                        Tooltip { text: root.can-copy-source ? @markdown("Copy the source path as text.") : @markdown("This native filename cannot be represented as clipboard text. The JSONL report retains its original encoding."); }
                                    }
                                }
                                if root.item-destination != "": Label { text: root.can-reveal ? "Reported copy path" : "Intended destination path"; font-weight: 600; }
                                if root.item-destination != "": HorizontalBox { padding: 0px; spacing: UiMetrics.gap;
                                    PathLabel { path: root.item-destination-path; text-size: root.ui-size; }
                                    TextButton { text: "Copy path"; accessible-label: "Copy destination path"; enabled: root.can-copy-destination; accessible-description: root.can-copy-destination ? "Copy the destination path as text." : "This native filename cannot be represented as clipboard text. The JSONL report retains its original encoding."; clicked => { root.copy-destination-path(); }
                                        Tooltip { text: root.can-copy-destination ? @markdown("Copy the destination path as text.") : @markdown("This native filename cannot be represented as clipboard text. The JSONL report retains its original encoding."); }
                                    }
                                }
                                for count in root.byte-counts: Label { text: count.label + ": " + count.value; accessible-label: count.accessible; }
                                if root.removals.length > 0: Label { text: root.removal-heading; font-weight: 600; }
                                for part in root.removals: VerticalBox { padding: 0px; spacing: UiMetrics.label-gap;
                                    Label { text: part.section + " · " + part.filename + " · " + part.media; wrap: word-wrap; }
                                    Label { text: part.reason; wrap: word-wrap; }
                                    Label { text: part.byte-accessible; }
                                }
                                if root.stripped.length > 0: Label { text: root.field-heading; font-weight: 600; }
                                for field in root.stripped: Label { text: field.text; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Palette.border; opacity: 0.35; }
        HorizontalBox { padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: UiMetrics.gap; padding-bottom: UiMetrics.gap; spacing: UiMetrics.gap; vertical-stretch: 0;
            Label { text: "Original messages stay unchanged. Existing copies are never replaced."; wrap: word-wrap; font-size: max(12px, root.ui-size * 0.86); opacity: 0.75; horizontal-stretch: 1; }
            if root.queue-notice != "": TextButton { text: "Queue paused"; accessible-description: root.queue-notice; clicked => { tasks.show(); } }
        }
        if root.storage-retry: HorizontalBox { padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: UiMetrics.gap; padding-bottom: UiMetrics.gap; spacing: UiMetrics.gap; vertical-stretch: 0;
            Label { text: root.queue-notice; color: root.attention-color; wrap: word-wrap; horizontal-stretch: 1; }
            ActionButton { text: "Retry storage"; clicked => { root.retry-report-storage(); } }
        }
    }
    tasks := PopupWindow {
        x: root.width - self.width - UiMetrics.gutter; y: header.height;
        width: min(520px, root.width - UiMetrics.gutter * 2); height: min(560px, root.height - 96px);
        close-policy: close-on-click-outside;
        Rectangle { background: Palette.background; border-width: 1px; border-color: Palette.border; border-radius: 6px;
            FocusScope { key-pressed(event) => { if event.text == Key.Escape { tasks.close(); return accept; } return reject; }
                VerticalBox { padding: UiMetrics.inset; spacing: UiMetrics.gap;
                    HorizontalBox { padding: 0px;
                        Label { text: "Tasks"; font-size: root.ui-size * 1.15; font-weight: 600; horizontal-stretch: 1; }
                        TextButton { text: "Close"; clicked => { tasks.close(); } }
                    }
                    if root.selection.length > 0: ActionButton { text: "Review selection (" + root.selection.length + ")"; accessible-label: "Review selection"; clicked => { tasks.close(); root.review-selection(); } }
                    if root.queue-notice != "": Label { text: root.queue-notice; wrap: word-wrap; color: root.attention-color; }
                    if root.queue-notice != "" && !root.report-storage-enabled: ActionButton {
                        text: "Allow temporary storage…";
                        enabled: !root.closing;
                        clicked => { root.show-storage-confirmation(); }
                    }
                    if root.storage-retry: ActionButton { text: "Retry storage"; clicked => { root.retry-report-storage(); } }
                    ScrollView { accessible-role: list; accessible-label: "Session tasks"; content-width: self.visible-width; content-height: task-content.preferred-height;
                        task-content := VerticalBox { width: parent.visible-width; height: self.preferred-height; padding: 0px; spacing: UiMetrics.inset;
                            if root.runs.length > 0: Label { text: "Session results · " + root.runs.length; font-weight: 600; }
                            VerticalBox { padding: 0px; spacing: UiMetrics.gap; accessible-role: list; accessible-label: "Retained reports";
                                for run[index] in root.runs: VerticalBox { padding: 0px; spacing: UiMetrics.label-gap;
                                    TextButton { text: (index == root.selected-run && !root.reviewing ? "✓ " : "") + run.label + " · " + run.mode;
                                        accessible-label: run.label; accessible-description: run.status + "; " + run.mode + "; " + run.selection.full + "; " + run.selections.accessible;
                                        accessible-item-selectable: true; accessible-item-selected: index == root.selected-run && !root.reviewing;
                                        clicked => { root.select-run(index); tasks.close(); }
                                        Tooltip { text: @markdown("\{run.selection.full} · \{run.destination}"); }
                                    }
                                    Label { text: run.status; wrap: word-wrap; }
                                    FileName { path: run.selection; text-size: root.ui-size; opacity: 0.75; }
                                }
                            }
                            if root.waiting.length > 0: Label { text: "Waiting · " + root.waiting.length; font-weight: 600; }
                            VerticalBox { padding: 0px; spacing: UiMetrics.inset; accessible-role: list; accessible-label: "Waiting selections";
                                for run[index] in root.waiting: VerticalBox { padding: 0px; spacing: UiMetrics.label-gap;
                                    HorizontalBox { padding: 0px; spacing: UiMetrics.gap;
                                        Label { text: run.label + " · " + run.mode; horizontal-stretch: 1; wrap: word-wrap; }
                                        TextButton { text: "Remove"; accessible-label: "Remove " + run.label; clicked => { root.remove-waiting(index); } }
                                    }
                                    FileName { path: run.selection; text-size: root.ui-size; }
                                    Label { text: run.destination + " · " + run.selections.accessible; wrap: word-wrap; opacity: 0.75; }
                                }
                            }
                            if root.runs.length == 0 && root.waiting.length == 0: Label { text: "No tasks have started in this session."; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }
    settings-popup := PopupWindow {
        width: min(720px, root.width - UiMetrics.gutter * 2); height: min(360px, root.height - 80px);
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; close-policy: close-on-click-outside;
        Rectangle { background: Palette.background; border-width: 1px; border-color: Palette.border; border-radius: 6px;
            FocusScope { forward-focus: settings-details-text;
                init => { settings-details-text.focus(); }
                key-pressed(event) => { if event.text == Key.Escape { settings-popup.close(); return accept; } return reject; }
                VerticalBox { padding: UiMetrics.gutter; spacing: UiMetrics.inset;
                    Label { text: "Destination settings"; font-weight: 600; }
                    settings-details-text := TextEdit { text: root.settings-warning; read-only: true; accessible-label: "Settings error and recovery details"; }
                    ActionButton { text: "Close"; accessible-label: "Close settings details"; clicked => { settings-popup.close(); } }
                }
            }
        }
    }
    destination-menu := PopupWindow {
        x: root.width - self.width - UiMetrics.gutter; y: header.height + 132px;
        width: max(260px, root.ui-size * 18); height: max(124px, root.ui-size * 8); close-policy: close-on-click-outside;
        Rectangle { background: Palette.background; border-width: 1px; border-color: Palette.border; border-radius: 6px;
            FocusScope { key-pressed(event) => { if event.text == Key.Escape { destination-menu.close(); return accept; } return reject; }
                VerticalBox { padding: UiMetrics.inset; spacing: UiMetrics.gap;
                    Label { text: "Copy destination"; font-weight: 600; }
                    TextButton { text: root.destination-beside ? "✓ Beside originals" : "Beside originals"; accessible-label: "Beside originals"; clicked => { destination-menu.close(); root.beside-source(); } }
                    ActionButton { text: "Choose folder…"; enabled: !root.closing; accessible-label: "Choose destination folder"; clicked => { destination-menu.close(); root.choose-destination(); } }
                }
            }
        }
    }
    storage-confirm := PopupWindow {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(560px, root.width - UiMetrics.gutter * 2); height: max(300px, root.ui-size * 20); close-policy: PopupClosePolicy.no-auto-close;
        Rectangle { background: Palette.background; border-width: 1px; border-color: Palette.border; border-radius: 6px;
            FocusScope { forward-focus: storage-cancel;
                init => { storage-cancel.focus(); }
                key-pressed(event) => { if event.text == Key.Escape { storage-confirm.close(); return accept; } return reject; }
                VerticalBox { padding: UiMetrics.gutter; spacing: UiMetrics.inset;
                    Label { text: "Allow temporary report storage?"; font-size: root.ui-size * 1.15; font-weight: 600; wrap: word-wrap; }
                    Label { text: "Exact diagnostic reports may contain message filenames, paths and attachment metadata. They will be kept in private temporary files so accepted queued work can continue."; wrap: word-wrap; }
                    Label { text: "Reports are removed when you close their results or quit. Up to 10 tasks may be retained, using at most 2.5 GiB for report streams. There is no persistent history."; wrap: word-wrap; }
                    HorizontalBox { padding: 0px; spacing: UiMetrics.gap; alignment: end;
                        storage-cancel := ActionButton { text: "Cancel"; clicked => { storage-confirm.close(); } }
                        ActionButton { text: "Allow for this session"; primary: true; clicked => { storage-confirm.close(); root.allow-report-storage(); } }
                    }
                }
            }
        }
    }
    storage-info := PopupWindow {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(520px, root.width - UiMetrics.gutter * 2); height: max(230px, root.ui-size * 16); close-policy: close-on-click-outside;
        Rectangle { background: Palette.background; border-width: 1px; border-color: Palette.border; border-radius: 6px;
            FocusScope { forward-focus: storage-info-close;
                init => { storage-info-close.focus(); }
                key-pressed(event) => { if event.text == Key.Escape { storage-info.close(); return accept; } return reject; }
                VerticalBox { padding: UiMetrics.gutter; spacing: UiMetrics.inset;
                    Label { text: "Private session reports"; font-weight: 600; }
                    Label { text: "Exact diagnostic reports are kept in private temporary storage until their results are closed or you quit. Up to 10 tasks may be retained, using at most 2.5 GiB for report streams. Storage failure pauses future work and preserves the current report."; wrap: word-wrap; }
                    storage-info-close := ActionButton { text: "Close"; clicked => { storage-info.close(); } }
                }
            }
        }
    }
    changed confirmation => { decision.close(); if root.confirmation != Confirmation.none { decision.show(); } }
    decision := PopupWindow {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(max(500px, root.ui-size * 31), root.width - UiMetrics.gutter * 2); height: max(300px, root.ui-size * 21); close-policy: PopupClosePolicy.no-auto-close;
        accessible-role: groupbox; accessible-label: root.confirmation == Confirmation.quit ? "Quit confirmation" : "Force Stop confirmation";
        Rectangle { background: Palette.background; border-width: 1px; border-color: Palette.border; border-radius: 6px;
            FocusScope { forward-focus: cancel-decision;
                init => { cancel-decision.focus(); }
                key-pressed(event) => { if event.text == Key.Escape { root.cancel-confirmation(); return accept; } return reject; }
                VerticalBox { padding: UiMetrics.gutter; spacing: UiMetrics.inset;
                    Label { text: root.confirmation == Confirmation.quit ? "Quit with unfinished work?" : "Force stop this task?"; font-size: root.ui-size * 1.15; font-weight: 600; wrap: word-wrap; }
                    Label { text: root.confirmation == Confirmation.quit ? (root.worker-running || root.export-running ? "A task or report export is still in progress. Quitting cancels waiting requests; completed copies and original messages are retained." : root.waiting.length + (root.waiting.length == 1 ? " request is waiting." : " requests are waiting.") + " Quitting cancels this queued work; originals and completed copies are retained.") : root.force-notice; wrap: word-wrap; }
                    if root.confirmation == Confirmation.quit: ActionButton { text: root.worker-running ? "Stop and wait" : (root.export-running ? "Finish export and quit" : "Cancel waiting and quit"); accessible-label: self.text; clicked => { root.stop-and-quit(); } }
                    if root.worker-running: TextButton { text: root.confirmation == Confirmation.quit ? "Force stop and quit" : "Force stop now"; danger: true; accessible-label: root.confirmation == Confirmation.quit ? "Force Stop and quit" : "Force Stop now"; accessible-description: "Stops the message worker abruptly. Any report export is allowed to finish."; clicked => { if root.confirmation == Confirmation.quit { root.force-and-quit(); } else { root.confirm-force-stop(); } } }
                    cancel-decision := ActionButton { text: root.confirmation == Confirmation.quit ? "Cancel quit" : "Cancel force stop"; accessible-label: self.text; clicked => { root.cancel-confirmation(); } }
                }
            }
        }
    }
}
