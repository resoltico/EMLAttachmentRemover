import { AboutSlint, Button, CheckBox, HorizontalBox, VerticalBox, ListView, ScrollView, Palette } from "std-widgets.slint";
export enum Confirmation { none, force-stop, quit }
export struct CountView { label: string, value: int, accessible: string }
export struct RunView { label: string, status: string, mode: string, selection: string, selections: CountView }
export struct ItemView { source: string, destination: string, status: string }
export struct DetailView { text: string }
export struct RemovalView { section: string, filename: string, media: string, bytes: int, byte-label: string, byte-accessible: string, reason: string }
component Label inherits Text { color: Palette.foreground; accessible-role: text; accessible-label: self.text; }
export component AboutWindow inherits Window {
    in property <string> product-name;
    title: "About " + root.product-name;
    background: Palette.background;
    default-font-size: 14px;
    preferred-width: 440px; preferred-height: 330px;
    in property <string> version;
    callback website(); callback licenses();
    VerticalBox { padding: 24px; spacing: 16px;
        Label { text: root.product-name; font-size: 22px; font-weight: 600; }
        Label { text: root.version; }
        HorizontalBox {
            Button { text: "Project website"; accessible-role: button; accessible-label: self.text; clicked => { root.website(); } }
            Button { text: "Third-party notices"; accessible-role: button; accessible-label: self.text; clicked => { root.licenses(); } }
        }
        AboutSlint { height: 100px; }
    }
}
export component MainWindow inherits Window {
    in property <string> product-name;
    title: root.product-name;
    background: Palette.background;
    default-font-size: 14px;
    preferred-width: 1060px; preferred-height: 760px;
    min-width: 780px; min-height: 600px;
    in property <string> version;
    in-out property <bool> check-only;
    in property <string> mode-label;
    in property <string> destination-label;
    in property <string> destination-scope;
    in property <string> run-label;
    in property <string> run-status;
    in property <string> queue-notice;
    in-out property <length> details-scroll-y <=> details-view.content-y;
    in property <[RunView]> runs;
    in property <[RunView]> waiting;
    in property <[ItemView]> items;
    in property <[CountView]> counts;
    in property <[DetailView]> messages;
    in property <[DetailView]> details;
    in property <[CountView]> byte-counts;
    in property <[RemovalView]> removals;
    in property <[DetailView]> stripped;
    in property <string> removal-heading;
    in property <string> field-heading;
    in property <string> item-source;
    in property <string> item-destination;
    in property <string> item-status;
    in property <bool> has-item;
    in property <bool> running;
    in property <bool> can-export;
    in property <bool> can-create;
    in property <bool> can-reveal;
    in property <bool> can-dismiss;
    in-out property <Confirmation> confirmation;
    in property <string> force-notice;
    callback choose-files(); callback choose-folder(); callback choose-destination(); callback beside-source();
    callback mode-changed(bool); callback select-run(int); callback select-item(int); callback remove-waiting(int);
    callback stop(); callback force-stop(); callback export-report(); callback reveal(); callback create-copies(); callback dismiss();
    callback confirm-force-stop();
    callback about(); callback keep-running(); callback stop-and-quit(); callback force-and-quit();
    MenuBar { Menu { title: "Help"; MenuItem { title: "About"; activated => { root.about(); } } } }
    VerticalBox { padding: 20px; spacing: 12px;
        HorizontalBox {
            Label { text: root.product-name; font-size: 24px; font-weight: 600; }
            Label { text: root.version; horizontal-alignment: right; }
            Button { text: "About"; accessible-role: button; accessible-label: self.text; clicked => { root.about(); } }
        }
        HorizontalBox {
            Button { text: "Choose files"; accessible-role: button; accessible-label: self.text; clicked => { root.choose-files(); } }
            Button { text: "Choose folder"; accessible-role: button; accessible-label: self.text; clicked => { root.choose-folder(); } }
            CheckBox { text: "Check only"; accessible-role: checkbox; accessible-label: self.text; checked <=> root.check-only; toggled => { root.mode-changed(self.checked); } }
            Label { text: root.mode-label; horizontal-alignment: right; }
        }
        HorizontalBox {
            Label { text: "Destination"; }
            Label { text: root.destination-label; overflow: elide; }
            Button { text: "Change destination"; accessible-role: button; accessible-label: self.text; clicked => { root.choose-destination(); } }
            Button { text: "Beside originals"; accessible-role: button; accessible-label: self.text; clicked => { root.beside-source(); } }
        }
        Label { text: root.destination-scope; font-size: 12px; }
        if root.queue-notice != "": Label { text: root.queue-notice; wrap: word-wrap; }
        if root.messages.length > 0: ListView {
            height: min(72px, root.messages.length * 24px); vertical-stretch: 0;
            accessible-role: list; accessible-label: "Diagnostics";
            for message in root.messages: Label { text: message.text; wrap: word-wrap; }
        }
        HorizontalBox { vertical-stretch: 1;
            VerticalBox { width: 205px; horizontal-stretch: 0;
                Label { text: "Reports"; font-weight: 600; }
                for run[index] in root.runs: VerticalBox {
                    Button { text: run.label; accessible-role: button; accessible-label: run.label; clicked => { root.select-run(index); } }
                    Label { text: run.status; wrap: word-wrap; }
                    Label { text: run.mode; }
                    Label { text: run.selection; overflow: elide; }
                    HorizontalBox { Label { text: run.selections.label; } Label { text: run.selections.value; accessible-label: run.selections.accessible; } }
                }
                Label { text: "Waiting selections"; font-weight: 600; }
                ListView { accessible-role: list; accessible-label: "Waiting selections";
                    for run[index] in root.waiting: HorizontalBox {
                        Label { text: run.label; }
                        Label { text: run.mode; }
                        Label { text: run.selections.value; accessible-label: run.selections.accessible; }
                        Button { text: "Remove"; accessible-role: button; accessible-label: "Remove " + run.label; clicked => { root.remove-waiting(index); } }
                    }
                }
                Button { text: "Dismiss report"; enabled: root.can-dismiss; accessible-role: button; accessible-label: self.text; clicked => { root.dismiss(); } }
            }
            VerticalBox {
                HorizontalBox { Label { text: root.run-label; font-weight: 600; } Label { text: root.run-status; } }
                HorizontalBox {
                    for count in root.counts: VerticalBox {
                        Label { text: count.label; }
                        Label { text: count.value; font-size: 21px; accessible-label: count.accessible; }
                    }
                }
                ListView { height: 145px; vertical-stretch: 0; accessible-role: list; accessible-label: "Message results";
                    for item[index] in root.items: VerticalBox {
                        Button { text: item.source; accessible-role: button; accessible-label: item.source; clicked => { root.select-item(index); } }
                        Label { text: item.status; }
                    }
                }
                details-view := ScrollView { vertical-stretch: 1; accessible-role: list; accessible-label: "Message details";
                    content-width: self.visible-width;
                    content-height: root.has-item ? detail-content.height : 0px;
                detail-content := VerticalBox {
                    visible: root.has-item;
                    width: details-view.visible-width;
                    height: self.preferred-height;
                    Label { text: root.item-source; wrap: word-wrap; }
                    Label { text: root.item-destination; wrap: word-wrap; }
                    Label { text: root.item-status; font-weight: 600; }
                    for count in root.byte-counts: HorizontalBox { Label { text: count.label; } Label { text: count.value; accessible-label: count.accessible; } }
                    for detail in root.details: Label { text: detail.text; wrap: word-wrap; }
                    Label { text: root.removal-heading; font-weight: 600; }
                    ListView { height: 150px; vertical-stretch: 0; accessible-role: list; accessible-label: root.removal-heading;
                        for part in root.removals: VerticalBox {
                            HorizontalBox { Label { text: part.section; } Label { text: part.filename; } Label { text: part.media; } }
                            HorizontalBox { Label { text: part.reason; } Label { text: part.byte-label; } Label { text: part.bytes; accessible-label: part.byte-accessible; } }
                        }
                    }
                    Label { text: root.field-heading; font-weight: 600; }
                    for field in root.stripped: Label { text: field.text; }
                }
                }
                HorizontalBox {
                    Button { text: "Stop"; enabled: root.running; accessible-role: button; accessible-label: self.text; clicked => { root.stop(); } }
                    Button { text: "Force Stop"; enabled: root.running; accessible-role: button; accessible-label: self.text; clicked => { root.force-stop(); } }
                    Button { text: "Save JSONL report"; enabled: root.can-export; accessible-role: button; accessible-label: self.text; clicked => { root.export-report(); } }
                    Button { text: "Reveal copy"; enabled: root.can-reveal; accessible-role: button; accessible-label: self.text; clicked => { root.reveal(); } }
                }
                if root.can-create: Button { text: "Create copies from this selection"; accessible-role: button; accessible-label: self.text; clicked => { root.create-copies(); } }
            }
        }
    }
    changed confirmation => {
        decision.close();
        if root.confirmation != Confirmation.none { decision.show(); }
    }
    decision := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 480px; height: 250px;
        close-policy: PopupClosePolicy.no-auto-close;
        accessible-role: groupbox;
        accessible-label: root.confirmation == Confirmation.quit ? "Quit confirmation" : "Force Stop confirmation";
        Rectangle { background: Palette.background;
        VerticalBox { padding: 24px; spacing: 16px;
            Label { text: root.confirmation == Confirmation.quit ? "A run or report export is still in progress." : root.force-notice; wrap: word-wrap; }
            if root.confirmation == Confirmation.quit: Button { text: "Stop and wait"; accessible-role: button; accessible-label: self.text; clicked => { root.stop-and-quit(); } }
            Button { text: root.confirmation == Confirmation.quit ? "Force Stop and quit" : "Force Stop now"; accessible-role: button; accessible-label: self.text; clicked => { if root.confirmation == Confirmation.quit { root.force-and-quit(); } else { root.confirm-force-stop(); } } }
            Button { text: "Keep running"; accessible-role: button; accessible-label: self.text; clicked => { root.keep-running(); } }
        }
        }
    }
}
