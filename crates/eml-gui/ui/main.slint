import { VerticalBox, HorizontalBox, Palette, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EmptyBatch } from "empty.slint";
import { BatchPane } from "batch.slint";
import { BatchState, Tone, EmailRow, EmailDetail, BatchView, AppWords, AttachmentView } from "models.slint";
import { Label, ActionButton, TextButton } from "controls.slint";
export { BatchState, Tone, EmailRow, EmailDetail, BatchView, AppWords, AttachmentView } from "models.slint";
export component MainWindow inherits Window {
    in property <string> product-name;
    in property <bool> native-about;
    in property <AppWords> words;
    in property <BatchView> view;
    in property <[EmailRow]> rows;
    in property <EmailDetail> detail;
    in property <[string]> recent-destinations;
    in property <[string]> output-roots;
    in-out property <bool> drop-hovered;
    title: root.product-name; icon: @image-url("eml-icon.png"); background: Theme.surface;
    default-font-size: Theme.body;
    min-width: 760px; min-height: 520px; preferred-width: 1080px; preferred-height: 700px;
    callback choose-files(); callback choose-folder(); callback choose-destination(); callback beside-source(); callback recent-destination(int);
    callback start-selection(); callback start-over(); callback stop(); callback toggle-problems();
    callback select-email(string); callback navigate-email(int,int); callback clear-selected();
    callback reveal-report(); callback show-copy(); callback show-original(); callback copy-details(); callback copy(); callback export-report(); callback reveal-output(int);
    callback close-window(); callback minimize(); callback website(); callback licenses(); callback about();
    in property <bool> text-copy-eligible;
    callback text-focus-changed();
    callback text-editors-changed();
    callback cancel-quit(); callback stop-and-quit(); callback quit-now();
    MenuBar {
        Menu { title: root.words.file;
            MenuItem { title: root.words.add-files; shortcut: @keys(Control + O); enabled: root.view.can-add; activated => { root.choose-files(); } }
            MenuItem { title: root.words.add-folder; shortcut: @keys(Control + Shift + O); enabled: root.view.can-add; activated => { root.choose-folder(); } }
            MenuItem { title: root.words.save-report; shortcut: @keys(Control + S); enabled: root.view.can-export; activated => { root.export-report(); } }
            if root.view.can-reveal-report: MenuItem { title: root.words.show-saved-report; activated => { root.reveal-report(); } }
            MenuItem { title: root.words.close; shortcut: @keys(Control + W); activated => { root.close-window(); } }
        }
        Menu { title: root.words.edit; MenuItem { title: root.words.copy; shortcut: @keys(Control + C); enabled: root.view.can-copy || root.text-copy-eligible; activated => { root.copy(); } } }
        Menu { title: root.words.batch;
            MenuItem { title: root.view.primary; shortcut: @keys(Control + Return); enabled: root.view.can-start; activated => { root.start-selection(); } }
            MenuItem { title: root.words.stop; shortcut: @keys(Control + "."); enabled: root.view.can-stop; activated => { root.stop(); } }
            MenuItem { title: root.words.show-output; shortcut: @keys(Control + Shift + R); enabled: root.view.can-output; activated => { root.show-output(); } }
            MenuItem { title: root.words.problems-only; shortcut: @keys(Control + "2"); checkable: true; checked: root.view.filtered; enabled: root.view.can-filter; activated => { root.toggle-problems(); } }
            MenuItem { title: root.words.start-over; shortcut: @keys(Control + Backspace); enabled: root.view.can-reset; activated => { root.start-over(); } }
        }
        Menu { title: root.words.window; MenuItem { title: root.words.minimize; shortcut: @keys(Control + M); activated => { root.minimize(); } } }
        Menu { title: root.words.help;
            MenuItem { title: root.words.website; activated => { root.website(); } }
            MenuItem { title: root.words.licenses; activated => { root.licenses(); } }
            if !root.native-about: MenuItem { title: root.words.about; activated => { root.about(); } }
        }
    }
    callback show-output();
    show-output => { if root.view.can-output { if root.output-roots.length == 1 { root.reveal-output(0); } else if root.output-roots.length > 1 { outputs.show(); } } }
    if root.view.state == BatchState.empty: EmptyBatch { words: root.words; notice: root.view.notice; can-reveal-report: root.view.can-reveal-report; reveal-report => { root.reveal-report(); } enabled: root.view.can-add; hovered: root.drop-hovered;
        add-files => { root.choose-files(); } add-folder => { root.choose-folder(); }
    }
    batch-pane := BatchPane { visible: root.view.state != BatchState.empty; words: root.words; view: root.view; rows: root.rows; detail: root.detail; hovered: root.drop-hovered;
        add-files => { root.choose-files(); } add-folder => { root.choose-folder(); } reset => { root.start-over(); }
        start => { root.start-selection(); } stop => { root.stop(); } filter => { root.toggle-problems(); }
        select(key) => { root.select-email(key); } navigate(delta,edge) => { root.navigate-email(delta,edge); } clear-selected => { root.clear-selected(); }
        text-focus-changed => { root.text-focus-changed(); }
        text-editors-changed => { root.text-editors-changed(); }
        reveal-report => { root.reveal-report(); }
        show-copy => { root.show-copy(); } show-original => { root.show-original(); } copy-details => { root.copy-details(); }
        destination => { destinations.show(); } output => { root.show-output(); }
    }

    destinations := PopupWindow { x: batch-pane.destination-anchor-x; y: batch-pane.destination-anchor-y - self.height; width: 340px;
        height: 88px + root.recent-destinations.length * 36px;
        Rectangle { background: Theme.raised; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-container;
            VerticalBox { padding: Theme.space-2; spacing: Theme.space-1;
                ActionButton { text: root.words.next-to; clicked => { destinations.close(); root.beside-source(); } }
                for folder[index] in root.recent-destinations: ActionButton { text: folder; clicked => { destinations.close(); root.recent-destination(index); } }
                ActionButton { text: root.words.choose-folder; clicked => { destinations.close(); root.choose-destination(); } }
            }
        }
    }
    outputs := PopupWindow { x: batch-pane.output-anchor-x + batch-pane.output-anchor-width - self.width; y: batch-pane.output-anchor-y - self.height; width: 420px; height: min(400px,16px + root.output-roots.length * 36px);
        Rectangle { background: Theme.raised; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-container;
            ListView { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; content-width: self.visible-width;
                for path[index] in root.output-roots: ActionButton { text: path; min-width: 0px; min-height: 36px; clicked => { outputs.close(); root.reveal-output(index); } }
            }
        }
    }
    private property <bool> show-quit: root.view.quit;
    changed show-quit => { if root.show-quit { decision.show(); } else { decision.close(); } }
    decision := PopupWindow { x: max(0px,(root.width - self.width) / 2); y: 70px; width: min(480px,root.width - Theme.space-6 * 2); height: content.preferred-height + 32px; close-policy: no-auto-close;
        Rectangle { background: Theme.raised; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-container;
            FocusScope { forward-focus: cancel;
                init => { cancel.focus(); }
                key-pressed(event) => { if event.text == Key.Escape { root.cancel-quit(); return accept; } return reject; }
                content := VerticalBox { padding: Theme.space-4; spacing: Theme.space-4;
                    Label { text: root.words.quit-title; font-size: Theme.title; font-weight: 700; }
                    Label { text: root.view.export-running ? root.words.export-body : root.words.quit-body; wrap: word-wrap; }
                    HorizontalBox { padding: 0px; spacing: Theme.space-2; alignment: end;
                        cancel := ActionButton { text: root.words.cancel; enabled: !root.view.quit-committed; clicked => { root.cancel-quit(); } }
                        ActionButton { text: root.words.stop-quit; enabled: !root.view.quit-committed; clicked => { root.stop-and-quit(); } }
                        if root.view.quit-now: ActionButton { text: root.words.quit-now; clicked => { root.quit-now(); } }
                    }
                }
            }
        }
    }
}

export { AboutWindow, LicenseWindow } from "about.slint";
export { Palette } from "std-widgets.slint";
export { Theme } from "theme.slint";
