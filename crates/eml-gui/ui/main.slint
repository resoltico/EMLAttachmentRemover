import { DecisionContent } from "dialogs.slint";
import { SessionTasks } from "sidebar.slint";
import { RunPane } from "run.slint";
import { DraftPane } from "draft.slint";
// Copyright 2026 Ervins Strauhmanis
// SPDX-License-Identifier: MPL-2.0
import { TextEdit, HorizontalBox, VerticalBox, ListView, ScrollView, ProgressIndicator, Palette, RadioGroup, CheckBox } from "std-widgets.slint";
import { ActionButton, TextButton, UiMetrics, Label, FileName, PathLabel } from "controls.slint";
import { Confirmation, CountView, PathView, RunView, ItemView, DetailView, RemovalView } from "models.slint";
export { Confirmation, CountView, PathView, RunView, ItemView, DetailView, RemovalView } from "models.slint";
export { AboutWindow, LicenseWindow } from "about.slint";
export { ExportWindow } from "export.slint";
export component MainWindow inherits Window {
    in property <string> product-name;
    title: root.product-name;
    icon: @image-url("eml-icon.png");
    background: Palette.background;
    in property <length> ui-size: 14px;
    default-font-size: root.ui-size;
    preferred-width: 1080px; preferred-height: 700px;
    min-width: 760px; min-height: 520px;
    in property <bool> native-about;
    in property <bool> closing;
    in-out property <bool> check-only;
    in property <string> destination-label;
    in property <[PathView]> selection;
    in property <bool> reviewing;
    in property <bool> can-start;
    in property <string> start-label;
    in property <string> start-reason;
    in property <bool> has-reports;
    in property <bool> worker-running;
    in property <string> activity-label;
    in property <string> run-label;
    in property <string> run-status;
    in property <string> run-context;
    in property <string> queue-notice;
    in-out property <length> details-scroll-y: 0px;
    in property <[RunView]> runs;
    in property <[RunView]> waiting;
    in property <[ItemView]> items;
    in property <[CountView]> counts;
    in property <[DetailView]> report-diagnostics;
    in property <string> settings-warning;
    in property <bool> can-copy-source;
    in property <bool> can-copy-destination;
    callback copy-source-path(); callback copy-destination-path();
    in property <string> operation-label;
    in property <string> operation-feedback;
    in property <PathView> item-source-path;
    in property <PathView> item-destination-path;
    in property <[DetailView]> details;
    in property <[CountView]> byte-counts;
    in property <[RemovalView]> removals;
    in property <[DetailView]> stripped;
    in property <string> removal-heading;
    in property <string> field-heading;
    in property <string> item-source;
    in property <string> item-destination;
    in property <string> item-status;
    in property <bool> has-item;
    in property <bool> item-attention;
    in property <bool> run-attention;
    private property <brush> attention-color: UiMetrics.attention;
    in property <int> selected-item;
    in property <int> selected-visible-row: -1;
    in-out property <bool> attention-only;
    in-out property <bool> keyboard-navigation;
    in property <bool> destination-beside;
    private property <length> message-row-height: max(56px, root.ui-size * 3.7);
    callback filter-attention(bool); callback navigate-message(int);
    in-out property <length> messages-scroll-y;
    out property <length> messages-view-height;
    function reveal-selected() {
        if root.messages-view-height > 0px {
            // Selection and viewport can arrive on different layout updates.
            if root.selected-visible-row >= 0 && root.selected-visible-row < root.items.length {
                if root.messages-scroll-y + root.selected-visible-row * root.message-row-height < 0px {
                    root.messages-scroll-y = -root.selected-visible-row * root.message-row-height;
                } else if root.messages-scroll-y + (root.selected-visible-row + 1) * root.message-row-height > root.messages-view-height {
                    root.messages-scroll-y = max(-root.selected-visible-row * root.message-row-height,
                        root.messages-view-height - (root.selected-visible-row + 1) * root.message-row-height);
                }
            }
            // Revealing a row must never scroll past the current content extent.
            root.messages-scroll-y = max(min(0px, root.messages-view-height - root.items.length * root.message-row-height),
                min(0px, root.messages-scroll-y));
        }
    }
    // MainWindow survives the task drawer that this transition closes.

    changed selected-visible-row => { root.reveal-selected(); }
    changed messages-view-height => { root.reveal-selected(); }
    changed message-row-height => { root.reveal-selected(); }
    changed keyboard-navigation => { if root.keyboard-navigation { root.reveal-selected(); } }

    in property <int> selected-run;
    in property <int> work-total;
    in property <int> work-completed;
    in-out property <bool> details-expanded: false;
    private property <string> technical-details-label: root.details-expanded ? "Hide technical details" : "Technical details";
    in property <bool> report-running;
    in property <bool> can-export;
    in property <bool> can-create;
    in property <bool> can-reveal;
    in property <bool> can-dismiss;
    in-out property <Confirmation> confirmation;
    in property <string> force-notice;
    callback choose-files(); callback choose-folder(); callback choose-destination(); callback beside-source();
    callback start-selection(); callback clear-selection(); callback review-selection(); callback remove-selection(int);
    callback mode-changed(bool); callback select-run(int); callback select-item(int); callback remove-waiting(int);
    callback stop(); callback force-stop(); callback export-report(); callback reveal(); callback review-request(); callback dismiss();
    callback confirm-force-stop();
    callback about(); callback cancel-confirmation(); callback stop-and-quit(); callback force-and-quit();
    // Distinct task lifetimes and action targets are supplied by the controller.
    in property <string> review-label;
    in property <bool> can-review;
    in property <bool> stop-requested;
    in property <bool> export-running;
    in property <bool> report-loading;
    in property <string> report-load-notice;
    in property <bool> can-reveal-report;
    in property <bool> native-open-pending;
    in property <string> operation-details;
    in property <string> report-details;
    in property <PathView> saved-report-path;
    private property <bool> operation-details-expanded: false;
    private property <bool> report-details-expanded: false;
    changed selected-run => { root.report-details-expanded = false; }
    private property <length> outcome-width: max(160px, min(220px, root.ui-size * 12));
    private property <string> selected-removals: root.selected-visible-row >= 0 && root.selected-visible-row < root.items.length ? root.items[root.selected-visible-row].removed : "";
    callback close-tasks();
    close-tasks => { tasks.close(); }
    callback new-request(); callback reveal-report();
    callback open-destination();
    open-destination => { destination-menu.show(); }

    MenuBar {
        Menu { title: "File";
            MenuItem { title: "New request"; shortcut: @keys(Control + N); enabled: !root.closing && root.confirmation == Confirmation.none; activated => { root.new-request(); } }
            MenuItem { title: "Open files…"; shortcut: @keys(Control + O); enabled: !root.closing && root.confirmation == Confirmation.none; activated => { root.choose-files(); } }
            MenuItem { title: "Add folder…"; enabled: !root.closing && root.confirmation == Confirmation.none; activated => { root.choose-folder(); } }
        }
        if !root.native-about: Menu { title: "Help";
            MenuItem { title: "About"; activated => { root.about(); } }
        }
    }
    VerticalBox { padding: 0px; spacing: 0px;
        header := HorizontalBox { padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: 12px; padding-bottom: 12px; spacing: UiMetrics.gap; vertical-stretch: 0;
            ActionButton { text: "Tasks" + (root.waiting.length > 0 ? " · " + root.waiting.length + " waiting" : ""); clicked => { tasks.show(); } }
            Rectangle { horizontal-stretch: 1; }
            ActionButton { text: "New request"; enabled: !root.closing; accessible-label: self.text; clicked => { root.new-request(); } }
        }
        Rectangle { height: 1px; background: Palette.border; opacity: 0.35; }
        if root.worker-running || root.export-running: HorizontalBox {
            padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: UiMetrics.gap; padding-bottom: UiMetrics.gap; spacing: UiMetrics.gap; vertical-stretch: 0;
            Label { text: root.activity-label; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; accessible-label: "Active task: " + root.activity-label; }
            if root.worker-running: TextButton { text: "Force stop…"; danger: true; enabled: !root.closing; clicked => { root.force-stop(); } }
            if root.worker-running: ActionButton { text: root.stop-requested ? "Stopping…" : "Stop"; enabled: !root.stop-requested && !root.closing; clicked => { root.stop(); } }
        }
        if root.settings-warning != "": HorizontalBox {
            padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: UiMetrics.label-gap; padding-bottom: UiMetrics.label-gap; spacing: UiMetrics.gap; vertical-stretch: 0;
            Label { text: "Settings unavailable — destination changes won't be saved"; wrap: word-wrap; color: root.attention-color; horizontal-stretch: 1; }
            TextButton { text: "Details…"; accessible-label: self.text + " — destination settings"; clicked => { settings-popup.show(); } }
        }
        if root.operation-feedback != "": VerticalBox {
            padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: UiMetrics.label-gap; padding-bottom: UiMetrics.label-gap; spacing: UiMetrics.label-gap; vertical-stretch: 0;
            HorizontalBox { padding: 0px; spacing: UiMetrics.gap;
                Label { text: root.operation-label + ": " + root.operation-feedback; wrap: word-wrap; horizontal-stretch: 1; accessible-live-region: polite; }
                if root.operation-details != "": TextButton { text: root.operation-details-expanded ? "Hide details" : "Details…"; expandable: true; expanded: root.operation-details-expanded; clicked => { root.operation-details-expanded = !root.operation-details-expanded; } }
            }
            if root.operation-details-expanded && root.operation-details != "": TextEdit { text: root.operation-details; read-only: true; preferred-height: 72px; max-height: 72px; accessible-label: "Operation technical details"; }
        }
        workspace := VerticalBox { padding: UiMetrics.gutter; spacing: UiMetrics.gap;
            if root.reviewing || !root.has-reports: DraftPane {
        attention-color : root.attention-color;
        can-start : root.can-start;
        check-only <=> root.check-only;
        choose-files() => { root.choose-files(); }
        choose-folder() => { root.choose-folder(); }
        clear-selection() => { root.clear-selection(); }
        closing : root.closing;
        destination-label : root.destination-label;
        message-row-height : root.message-row-height;
        mode-changed(arg0) => { root.mode-changed(arg0); }
        open-destination() => { root.open-destination(); }
        remove-selection(arg0) => { root.remove-selection(arg0); }
        selection : root.selection;
        start-label : root.start-label;
        start-reason : root.start-reason;
        start-selection() => { root.start-selection(); }
        ui-size : root.ui-size;
    }
            if root.has-reports && !root.reviewing: RunPane {
        attention-color : root.attention-color;
        attention-only <=> root.attention-only;
        byte-counts : root.byte-counts;
        can-copy-destination : root.can-copy-destination;
        can-copy-source : root.can-copy-source;
        can-create : root.can-create;
        can-dismiss : root.can-dismiss;
        can-export : root.can-export;
        can-reveal : root.can-reveal;
        can-reveal-report : root.can-reveal-report;
        can-review : root.can-review;
        closing : root.closing;
        copy-destination-path() => { root.copy-destination-path(); }
        copy-source-path() => { root.copy-source-path(); }
        counts : root.counts;
        details : root.details;
        details-expanded <=> root.details-expanded;
        details-scroll-y <=> root.details-scroll-y;
        dismiss() => { root.dismiss(); }
        export-report() => { root.export-report(); }
        field-heading : root.field-heading;
        filter-attention(arg0) => { root.filter-attention(arg0); }
        has-item : root.has-item;
        item-attention : root.item-attention;
        item-destination : root.item-destination;
        item-destination-path : root.item-destination-path;
        item-source-path : root.item-source-path;
        items : root.items;
        keyboard-navigation <=> root.keyboard-navigation;
        message-row-height : root.message-row-height;
        messages-scroll-y <=> root.messages-scroll-y;
        messages-view-height <=> root.messages-view-height;
        native-open-pending : root.native-open-pending;
        navigate-message(arg0) => { root.navigate-message(arg0); }
        outcome-width : root.outcome-width;
        removal-heading : root.removal-heading;
        removals : root.removals;
        report-details : root.report-details;
        report-details-expanded <=> root.report-details-expanded;
        report-diagnostics : root.report-diagnostics;
        report-load-notice : root.report-load-notice;
        report-loading : root.report-loading;
        report-running : root.report-running;
        reveal() => { root.reveal(); }
        reveal-report() => { root.reveal-report(); }
        reveal-selected() => { root.reveal-selected(); }
        review-label : root.review-label;
        review-request() => { root.review-request(); }
        run-context : root.run-context;
        run-label : root.run-label;
        run-status : root.run-status;
        saved-report-path : root.saved-report-path;
        select-item(arg0) => { root.select-item(arg0); }
        selected-item : root.selected-item;
        selected-removals : root.selected-removals;
        selection : root.selection;
        stripped : root.stripped;
        technical-details-label : root.technical-details-label;
        ui-size : root.ui-size;
        work-completed : root.work-completed;
        work-total : root.work-total;
    }
        }
        Rectangle { height: 1px; background: Palette.border; opacity: 0.35; }
        HorizontalBox { padding-left: UiMetrics.gutter; padding-right: UiMetrics.gutter; padding-top: UiMetrics.gap; padding-bottom: UiMetrics.gap; spacing: UiMetrics.gap; vertical-stretch: 0;
            Label { text: "Original messages stay unchanged. Existing copies are never replaced."; wrap: word-wrap; font-size: max(12px, root.ui-size * 0.86); opacity: 0.75; horizontal-stretch: 1; }
            if root.queue-notice != "": Label { text: root.queue-notice; wrap: word-wrap; color: root.attention-color; }
        }

    }
    tasks := PopupWindow {
        x: root.width - self.width - UiMetrics.gutter; y: header.height;
        width: min(520px, root.width - UiMetrics.gutter * 2); height: min(560px, root.height - 96px);
        close-policy: close-on-click-outside;
        SessionTasks {
        attention-color : root.attention-color;
        close-tasks() => { root.close-tasks(); }
        closing : root.closing;
        queue-notice : root.queue-notice;
        remove-waiting(arg0) => { root.remove-waiting(arg0); }
        review-selection() => { root.review-selection(); }
        reviewing : root.reviewing;
        runs : root.runs;
        select-run(arg0) => { root.select-run(arg0); }
        selected-run : root.selected-run;
        selection : root.selection;
        ui-size : root.ui-size;
        waiting : root.waiting;
    }
    }
    settings-popup := PopupWindow {
        width: min(720px, root.width - UiMetrics.gutter * 2); height: min(360px, root.height - 80px);
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; close-policy: close-on-click-outside;
        Rectangle { background: Palette.background; border-width: 1px; border-color: Palette.border; border-radius: 6px;
            FocusScope { forward-focus: settings-details-text;
                init => { settings-details-text.focus(); }
                key-pressed(event) => { if event.text == Key.Escape { settings-popup.close(); return accept; } return reject; }
                VerticalBox { padding: UiMetrics.gutter; spacing: UiMetrics.inset;
                    Label { text: "Destination settings"; font-weight: 600; }
                    settings-details-text := TextEdit { text: root.settings-warning; read-only: true; accessible-label: "Settings error and recovery details"; }
                    ActionButton { text: "Close"; accessible-description: "Close destination settings details."; clicked => { settings-popup.close(); } }
                }
            }
        }
    }
    destination-menu := PopupWindow {
        x: root.width - self.width - UiMetrics.gutter; y: header.height + 132px;
        width: max(260px, root.ui-size * 18); height: max(124px, root.ui-size * 8); close-policy: close-on-click-outside;
        Rectangle { background: Palette.background; border-width: 1px; border-color: Palette.border; border-radius: 6px;
            FocusScope { key-pressed(event) => { if event.text == Key.Escape { destination-menu.close(); return accept; } return reject; }
                VerticalBox { padding: UiMetrics.inset; spacing: UiMetrics.gap;
                    Label { text: "Copy destination"; font-weight: 600; }
                    TextButton { text: root.destination-beside ? "✓ Beside originals" : "Beside originals"; accessible-label: "Beside originals"; accessible-checkable: true; accessible-checked: root.destination-beside; clicked => { destination-menu.close(); root.beside-source(); } }
                    ActionButton { text: "Choose folder…"; enabled: !root.closing; accessible-description: "Choose the copy destination folder."; clicked => { destination-menu.close(); root.choose-destination(); } }
                }
            }
        }
    }


    changed confirmation => { decision.close(); if root.confirmation != Confirmation.none { decision.show(); } }
    decision := PopupWindow {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(max(500px, root.ui-size * 31), root.width - UiMetrics.gutter * 2); height: max(300px, root.ui-size * 21); close-policy: PopupClosePolicy.no-auto-close;
        accessible-role: groupbox; accessible-label: root.confirmation == Confirmation.quit ? "Quit confirmation" : "Force Stop confirmation";
        DecisionContent {
        cancel-confirmation() => { root.cancel-confirmation(); }
        confirm-force-stop() => { root.confirm-force-stop(); }
        confirmation <=> root.confirmation;
        export-running : root.export-running;
        force-and-quit() => { root.force-and-quit(); }
        force-notice : root.force-notice;
        stop-and-quit() => { root.stop-and-quit(); }
        ui-size : root.ui-size;
        waiting : root.waiting;
        worker-running : root.worker-running;
    }
    }
}
